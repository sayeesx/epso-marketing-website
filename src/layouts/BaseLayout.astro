---
import SEO from '../components/seo/SEO.astro';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/navigation/Footer.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import { getSiteUrl } from '../lib/siteUrl';
import type { SanityImageAsset } from '../types/index';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string | SanityImageAsset;
  imageAlt?: string;
  type?: 'website' | 'article' | 'product';
  noindex?: boolean;
  keywords?: string[];
  publishedTime?: string;
  modifiedTime?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonical,
  image,
  imageAlt,
  type,
  noindex,
  keywords,
  publishedTime,
  modifiedTime,
  structuredData,
} = Astro.props;

const siteUrl = getSiteUrl(Astro.site);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'WholesaleStore'],
  '@id': `${siteUrl}/#organization`,
  name: 'Epso',
  alternateName: ['Epso Marketing', 'EPSO BAKERY & STATIONERY WHOLESALE'],
  legalName: 'EPSO BAKERY & STATIONERY WHOLESALE',
  description:
    'Epso is an Indian FMCG brand supported by EPSO BAKERY & STATIONERY WHOLESALE, a wholesale and retail supplier in Cherukulamba, Malappuram district, Kerala, founded by Jabir T.',
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    url: `${siteUrl}/epso-marketing-logo-cherukulamba-malappuram-kerala.png`,
    contentUrl: `${siteUrl}/epso-marketing-logo-cherukulamba-malappuram-kerala.png`,
    caption: 'Epso Marketing Official Logo - Cherukulamba, Malappuram, Kerala',
  },
  image: `${siteUrl}/assets/banners/EPSO-Marketing-Truck-on-Globe.webp`,
  telephone: '+91-98096-65188',
  email: 'hello@epso.in',
  hasMap: 'https://share.google/xUXNsXc0cXicOHcHz',
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: 'hello@epso.in',
      telephone: '+91-98096-65188',
      availableLanguage: ['English', 'Malayalam'],
    },
    {
      '@type': 'ContactPoint',
      contactType: 'general inquiries',
      email: 'contact@epso.in',
      telephone: '+91-98096-65188',
    },
    {
      '@type': 'ContactPoint',
      contactType: 'sales',
      email: 'sales@epso.in',
      telephone: '+91-98096-65188',
    },
  ],
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'Kerala, India',
  },
  founder: {
    '@type': 'Person',
    '@id': `${siteUrl}/#jabir-t`,
    name: 'Jabir T',
    jobTitle: 'Founder, Epso Marketing & Elected Member, Ponmala Grama Panchayat',
    image: `${siteUrl}/jabir-t-founder-epso-marketing-ponmala-grama-panchayat.webp`,
    memberOf: {
      '@type': 'GovernmentOrganization',
      name: 'Ponmala Grama Panchayat',
    },
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Cherukulamba',
    addressLocality: 'Cherukulamba',
    addressRegion: 'Malappuram, Kerala',
    addressCountry: 'IN',
  },
  knowsAbout: [
    'Kerala mixtures',
    'Everyday snacks and biscuits',
    'Dishwashing liquids',
    'Floor cleaners',
    'Household cleaning products',
    'Wholesale and retail FMCG supply in Malappuram, Kerala',
  ],
  sameAs: [
    'https://www.instagram.com/epso.in',
    'https://www.facebook.com/epso',
    'https://www.linkedin.com/company/epso',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Epso',
  url: siteUrl,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}/products/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const allStructuredData = [
  orgSchema,
  websiteSchema,
  ...(structuredData
    ? Array.isArray(structuredData)
      ? structuredData
      : [structuredData]
    : []),
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Multi-browser, platform & device favicons -->
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="msapplication-TileColor" content="#1a202c" />
    <meta name="theme-color" content="#1a202c" />

    <link rel="preload" href="/assets/fonts/Insanibc.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      imageAlt={imageAlt}
      type={type}
      noindex={noindex}
      keywords={keywords}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />
    <StructuredData data={allStructuredData} />
  </head>
  <body class="min-h-screen flex flex-col relative text-brand-800 antialiased selection:bg-accent-500/20 selection:text-brand-900">
    <!-- Awwwards-grade subtle film grain texture to eliminate banding and add tactile depth -->
    <div
      class="pointer-events-none fixed inset-0 z-40 opacity-[0.02] mix-blend-overlay"
      style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.8%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');"
      aria-hidden="true"
    ></div>

    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:btn-primary"
    >
      Skip to content
    </a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
