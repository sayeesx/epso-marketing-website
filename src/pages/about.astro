---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCta from '../components/sections/ContactCta.astro';
import PhosphorIcon from '../components/ui/PhosphorIcon.astro';
---
<BaseLayout
  title="About Epso"
  description="Epso is an Indian FMCG brand making food and home care products for everyday households."
>
  <div class="section-pad">
    <div class="container-site">
      <div class="mx-auto max-w-3xl">
        <h1 class="mb-6 text-brand-800">About Epso</h1>

        <div class="glass-panel border-amber-500/25 bg-amber-500/10 p-5 mb-8">
          <p class="text-sm text-amber-900 font-medium flex items-center gap-2">
            <PhosphorIcon name="note-pencil" size={18} class="text-amber-800 flex-shrink-0" />
            <span>This content is a placeholder. Update it with the actual Epso company story in Sanity CMS or directly in this file.</span>
          </p>
        </div>

        <div class="space-y-6 text-brand-700 leading-relaxed">
          <p class="text-lg font-medium text-brand-900">
            Epso is an Indian FMCG brand making everyday products for homes across Kerala.
          </p>

          <p>
            We make food products like Kerala mixtures, snacks and biscuits. We also make home care products like dishwashing liquids, floor cleaners and household cleaning products.
          </p>

          <p>
            Our goal is simple — make good products that everyday Indian families can trust and afford.
          </p>

          <div class="glass-panel p-6 sm:p-8">
            <h2 class="mb-4 text-xl font-bold text-brand-900">Company information</h2>
            <div class="space-y-3 text-sm text-brand-700">
              <p class="flex items-center gap-2.5">
                <PhosphorIcon name="map-pin" size={18} class="text-amber-700 flex-shrink-0" />
                <span>Address: <em>[To be updated]</em></span>
              </p>
              <p class="flex items-center gap-2.5">
                <PhosphorIcon name="phone" size={18} class="text-amber-700 flex-shrink-0" />
                <span>Phone: <em>[To be updated]</em></span>
              </p>
              <p class="flex items-center gap-2.5">
                <PhosphorIcon name="envelope-simple" size={18} class="text-amber-700 flex-shrink-0" />
                <span>Email: <em>[To be updated]</em></span>
              </p>
              <p class="flex items-center gap-2.5">
                <PhosphorIcon name="buildings" size={18} class="text-amber-700 flex-shrink-0" />
                <span>Registered: <em>[To be updated]</em></span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <ContactCta heading="Want to know more?" />
</BaseLayout>

