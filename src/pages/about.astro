---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCta from '../components/sections/ContactCta.astro';
---
<BaseLayout
  title="About Epso"
  description="Epso is an Indian FMCG brand making food and home care products for everyday households."
>
  <div class="section-pad">
    <div class="container-site">
      <div class="mx-auto max-w-3xl">
        <h1 class="mb-6 text-brand-800">About Epso</h1>

        <div class="rounded-lg border border-accent-200 bg-accent-50 p-5 mb-8">
          <p class="text-sm text-accent-700 font-medium">
            📝 This content is a placeholder. Update it with the actual Epso company story in Sanity CMS or directly in this file.
          </p>
        </div>

        <div class="space-y-6 text-brand-600 leading-relaxed">
          <p class="text-lg">
            Epso is an Indian FMCG brand making everyday products for homes across Kerala.
          </p>

          <p>
            We make food products like Kerala mixtures, snacks and packaged nuts. We also make home care products like dishwashing liquids, floor cleaners and household cleaning products.
          </p>

          <p>
            Our goal is simple — make good products that everyday Indian families can trust and afford.
          </p>

          <div class="rounded-lg bg-brand-50 p-6">
            <h2 class="mb-3 text-brand-800">Company information</h2>
            <div class="space-y-2 text-sm text-brand-500">
              <p>📍 Address: <em>[To be updated]</em></p>
              <p>📞 Phone: <em>[To be updated]</em></p>
              <p>📧 Email: <em>[To be updated]</em></p>
              <p>🏢 Registered: <em>[To be updated]</em></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <ContactCta heading="Want to know more?" />
</BaseLayout>

