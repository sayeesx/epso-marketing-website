---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Page not found"
  description="Sorry, this page does not exist."
  noindex={true}
>
  <div class="section-pad min-h-[60vh] flex items-center">
    <div class="container-site text-center">
      <div class="text-7xl font-bold text-brand-200 mb-4" aria-hidden="true">404</div>
      <h1 class="mb-3 text-brand-800">Page not found</h1>
      <p class="mb-8 text-brand-500">Sorry, we could not find that page.</p>
      <div class="flex flex-col gap-3 sm:flex-row justify-center">
        <a href="/" class="btn-primary">Go to homepage</a>
        <a href="/products/" class="btn-secondary">Browse products</a>
      </div>
    </div>
  </div>
</BaseLayout>

