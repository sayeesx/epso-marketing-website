---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Page not found"
  description="Sorry, this page does not exist."
  noindex={true}
>
  <div class="section-pad min-h-[60vh] flex items-center justify-center">
    <div class="container-site text-center">
      <div class="text-8xl font-black text-amber-500/25 mb-4 tracking-tighter" aria-hidden="true">404</div>
      <h1 class="mb-3 text-brand-900">Page not found</h1>
      <p class="mb-8 text-brand-600 text-lg">Sorry, we could not find that page.</p>
      <div class="flex flex-col gap-3 sm:flex-row justify-center">
        <a href="/" class="btn-primary">Go to homepage</a>
        <a href="/products/" class="btn-secondary">Browse products</a>
      </div>
    </div>
  </div>
</BaseLayout>

