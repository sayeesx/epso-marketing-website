---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import FeaturedCategories from '../components/sections/FeaturedCategories.astro';
import FeaturedProducts from '../components/sections/FeaturedProducts.astro';
import WhyEpso from '../components/sections/WhyEpso.astro';
import ArrowButton from '@components/ui/ArrowButton.astro';
import { sanityClient } from '../lib/sanity';
import { getSiteUrl } from '../lib/siteUrl';
import {
  getHomepageContentQuery,
  getRootCategoriesQuery,
  getFeaturedProductsQuery,
} from '../lib/queries';
import type { HomepageContent, Category, Product } from '../types/index';

// Fetch from Sanity during build — graceful fallback if Sanity not yet configured
let homepage: HomepageContent | null = null;
let categories: Category[] = [];
let featuredProducts: Product[] = [];

try {
  [homepage, categories, featuredProducts] = await Promise.all([
    sanityClient.fetch(getHomepageContentQuery),
    sanityClient.fetch(getRootCategoriesQuery),
    sanityClient.fetch(getFeaturedProductsQuery),
  ]);
} catch {
  // Sanity not yet configured — use placeholder content
  // Configure SANITY_PROJECT_ID in .env to enable full content
}

// Fallback placeholder categories when Sanity is not configured
const displayCategories: Category[] =
  categories.length > 0
    ? categories
    : [
        {
          _id: 'placeholder-food',
          _type: 'category',
          name: 'Food Products',
          slug: { _type: 'slug', current: 'food' },
          description: 'Kerala mixtures, snacks, biscuits and more.',
          imageUrl: '/epso-food-products-kerala-mixture-snacks-biscuits.webp',
        },
        {
          _id: 'placeholder-homecare',
          _type: 'category',
          name: 'Home Care',
          slug: { _type: 'slug', current: 'home-care' },
          description: 'Dishwashing, floor cleaners and household cleaning products.',
          imageUrl: '/epso-home-care-dishwash-floor-cleaner-products.webp',
        },
      ];

const siteUrl = getSiteUrl(Astro.site);

const homepageStructuredData: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${siteUrl}/#jabir-t`,
    name: 'Jabir T',
    jobTitle: 'Founder, Epso Marketing & Elected Member, Ponmala Grama Panchayat',
    description:
      'Jabir T is the founder of Epso Marketing and an elected member of the Ponmala Grama Panchayat in Malappuram district, Kerala.',
    image: {
      '@type': 'ImageObject',
      url: `${siteUrl}/jabir-t-founder-epso-marketing-ponmala-grama-panchayat.webp`,
      contentUrl: `${siteUrl}/jabir-t-founder-epso-marketing-ponmala-grama-panchayat.webp`,
      caption: 'Jabir T, Founder of Epso Marketing and Elected Member of Ponmala Grama Panchayat',
    },
    worksFor: {
      '@type': 'Organization',
      name: 'Epso Marketing',
      legalName: 'EPSO BAKERY & STATIONERY WHOLESALE',
    },
    memberOf: {
      '@type': 'GovernmentOrganization',
      name: 'Ponmala Grama Panchayat',
    },
    homeLocation: {
      '@type': 'Place',
      name: 'Cherukulamba, Malappuram district, Kerala, India',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ImageGallery',
    name: 'Epso Marketing Official Brand and Product Images',
    associatedMedia: [
      {
        '@type': 'ImageObject',
        name: 'Epso Marketing Delivery Truck on Globe',
        contentUrl: `${siteUrl}/assets/banners/EPSO-Marketing-Truck-on-Globe.webp`,
        caption: 'Epso marketing truck delivering everyday food and home care products across Kerala and India',
      },
      {
        '@type': 'ImageObject',
        name: 'Epso Food Products - Kerala Mixture, Snacks and Biscuits',
        contentUrl: `${siteUrl}/epso-food-products-kerala-mixture-snacks-biscuits.webp`,
        caption: 'Epso Food Products including Kerala mixtures, snacks, and biscuits',
      },
      {
        '@type': 'ImageObject',
        name: 'Epso Home Care - Dishwashing Liquid and Floor Cleaners',
        contentUrl: `${siteUrl}/epso-home-care-dishwash-floor-cleaner-products.webp`,
        caption: 'Epso Home Care dishwashing liquids, floor cleaners, and household cleaning products',
      },
      {
        '@type': 'ImageObject',
        name: 'Jabir T - Founder of Epso Marketing',
        contentUrl: `${siteUrl}/jabir-t-founder-epso-marketing-ponmala-grama-panchayat.webp`,
        caption: 'Jabir T, Founder of Epso Marketing and Elected Member of Ponmala Grama Panchayat',
      },
    ],
  },
];
---
<BaseLayout
  title="Everyday Food & Home Care Products by Epso Marketing"
  description="Epso and Epso Marketing (EPSO BAKERY & STATIONERY WHOLESALE) in Cherukulamba, Malappuram, Kerala make everyday food, Kerala mixtures, and home care products."
  image={homepage?.ogImage || homepage?.heroImage || '/assets/banners/EPSO-Marketing-Truck-on-Globe.webp'}
  imageAlt="Epso Marketing everyday food and home care products from Cherukulamba, Malappuram, Kerala"
  structuredData={homepageStructuredData}
>
  <Hero
    heading={homepage?.heroHeading || 'From Our Products to Your Everyday Moments.'}
    subheading={homepage?.heroSubheading ||
      'Epso makes everyday food and home care products for Indian households.'}
    imageSrc="/assets/banners/EPSO-Marketing-Truck-on-Globe.webp"
    imageAlt="Epso marketing truck delivering everyday food and home care products on the globe"
  />

  <FeaturedCategories categories={displayCategories} />

  {featuredProducts.length > 0 && <FeaturedProducts products={featuredProducts} />}

  <!-- Brand introduction -->
  <section class="section-pad bg-white">
    <div class="container-site">
      <div
        class="relative mx-auto max-w-4xl overflow-hidden rounded-3xl border border-brand-200/80 shadow-sm grid grid-cols-1 md:grid-cols-12 items-center"
        style="background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF5 38%, #FFF3E2 72%, #FDE5C6 100%);"
      >
        <div class="md:col-span-7 p-8 sm:p-10 md:p-12 text-center md:text-left">
          <h2 class="section-title text-2xl sm:text-3xl font-bold">{homepage?.brandIntroTitle || 'About Epso'}</h2>
          <p class="section-subtitle mt-3 max-w-xl mx-auto md:mx-0">
            {homepage?.brandIntroText ||
              'Epso is an Indian FMCG brand based in Cherukulamba, Malappuram, Kerala, making everyday food and home care products for homes across Kerala.'}
          </p>
          <div class="mt-8">
            <a href="/about/" class="group btn-secondary inline-flex items-center gap-2.5 pr-3">
              <span>Learn more about us</span>
              <ArrowButton as="span" direction="right" size="sm" color="#1a202c" hoverColor="#eb8d35" />
            </a>
          </div>
        </div>

        <div class="md:col-span-5 relative h-full flex flex-col items-center justify-end px-6 pt-4 pb-5 md:pt-6">
          <img
            src="/jabir-t-founder-epso-marketing-ponmala-grama-panchayat.webp"
            alt="Jabir T, Founder of Epso Marketing and Elected Member of Ponmala Grama Panchayat"
            title="Jabir T - Founder of Epso Marketing and Ponmala Grama Panchayat Elected Member"
            width="1008"
            height="1047"
            loading="lazy"
            class="w-48 sm:w-52 md:w-52 h-48 sm:h-52 md:h-52 object-fill select-none"
          />
          <div class="-mt-3 relative z-10 rounded-2xl border border-brand-200/90 bg-white/95 px-4 py-2 text-center shadow-xs backdrop-blur-sm">
            <p class="text-xs font-bold text-brand-950 leading-tight">Jabir T</p>
            <p class="text-[11px] font-medium text-brand-600 leading-tight">Founder, Epso Marketing</p>
            <p class="text-[10px] font-medium text-brand-500 leading-tight mt-0.5">Elected Member, Ponmala Grama Panchayat</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <WhyEpso />
</BaseLayout>
