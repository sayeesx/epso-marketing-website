---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import SanityImage from '../../components/ui/SanityImage.astro';
import ArrowButton from '@components/ui/ArrowButton.astro';
import { sanityClient } from '../../lib/sanity';
import { getAllBlogPostsQuery } from '../../lib/queries';
import type { BlogPost } from '../../types/index';

let posts: BlogPost[] = [];
try {
  posts = await sanityClient.fetch(getAllBlogPostsQuery);
} catch {
  // Sanity not configured yet
}

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog/' },
];
---
<BaseLayout title="Blog" description="Tips, recipes and articles from Epso.">
  <div class="section-pad">
    <div class="container-site">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="mb-2 text-brand-800">Blog</h1>
      <p class="mb-8 text-brand-500">Tips and articles from Epso.</p>

      {posts.length > 0 ? (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <article class="card group overflow-hidden">
              <a href={`/blog/${post.slug}/`} class="block" aria-label={post.title}>
                <div class="m-2.5 aspect-video overflow-hidden rounded-xl bg-white/70 border border-white/50">
                  <SanityImage
                    image={post.mainImage}
                    alt={post.title}
                    width={400}
                    height={225}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </div>
              </a>
              <div class="p-5 pt-3">
                {post.publishedAt && (
                  <time class="text-xs font-semibold text-amber-900 bg-amber-500/15 px-2.5 py-0.5 rounded-full inline-block mb-2" datetime={post.publishedAt}>
                    {new Date(post.publishedAt).toLocaleDateString('en-IN', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </time>
                )}
                <h2 class="mt-1 mb-2 text-base font-semibold text-brand-900 leading-snug group-hover:text-[#eb8d35] transition-colors">
                  <a href={`/blog/${post.slug}/`}>
                    {post.title}
                  </a>
                </h2>
                {post.excerpt && (
                  <p class="text-sm text-brand-600 line-clamp-2 leading-relaxed">{post.excerpt}</p>
                )}
                <a
                  href={`/blog/${post.slug}/`}
                  class="group mt-4 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-brand-800 hover:text-[#eb8d35] transition-colors"
                >
                  <span>Read article</span>
                  <ArrowButton as="span" direction="right" size="sm" color="#0f1420" hoverColor="#eb8d35" />
                </a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="py-16 text-center">
          <p class="text-brand-500">No articles yet. Check back soon.</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

