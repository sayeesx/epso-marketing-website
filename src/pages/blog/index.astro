---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import SanityImage from '../../components/ui/SanityImage.astro';
import ArrowButton from '@components/ui/ArrowButton.astro';
import { sanityClient } from '../../lib/sanity';
import { getAllBlogPostsQuery } from '../../lib/queries';
import { localBlogPosts } from '../../data/blogPosts';
import { getSiteUrl } from '../../lib/siteUrl';
import type { BlogPost } from '../../types/index';

let sanityPosts: BlogPost[] = [];
try {
  sanityPosts = await sanityClient.fetch(getAllBlogPostsQuery);
} catch {
  // Sanity not configured yet
}

interface UnifiedBlogCard {
  slug: string;
  title: string;
  excerpt: string;
  publishedAt?: string;
  category?: string;
  readTime?: string;
  sanityImage?: BlogPost['mainImage'];
  localImage?: string;
  imageAlt: string;
  imageTitle: string;
}

const sanitySlugs = new Set((sanityPosts || []).map((p) => p.slug));

const unifiedPosts: UnifiedBlogCard[] = [
  ...(sanityPosts || []).map((post) => ({
    slug: post.slug,
    title: post.title,
    excerpt: post.excerpt || '',
    publishedAt: post.publishedAt,
    sanityImage: post.mainImage,
    imageAlt: post.title,
    imageTitle: `${post.title} - Epso Blog`,
  })),
  ...localBlogPosts
    .filter((post) => !sanitySlugs.has(post.slug))
    .map((post) => ({
      slug: post.slug,
      title: post.title,
      excerpt: post.excerpt,
      publishedAt: post.publishedAt,
      category: post.category,
      readTime: post.readTime,
      localImage: post.image,
      imageAlt: post.imageAlt,
      imageTitle: post.imageTitle,
    })),
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog/' },
];

const siteUrl = getSiteUrl(Astro.site);
const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Epso & Epso Marketing Blog',
  description:
    'Guides, stories, and helpful articles about Epso food products, home care essentials, EPSO BAKERY & STATIONERY WHOLESALE in Cherukulamba, Malappuram, and founder Jabir T.',
  url: `${siteUrl}/blog/`,
  publisher: {
    '@id': `${siteUrl}/#organization`,
  },
};
---
<BaseLayout
  title="Blog & Guides – Epso Food, Home Care & Epso Marketing"
  description="Read articles about Epso food products, Kerala mixtures, dishwashing and floor care, EPSO BAKERY & STATIONERY WHOLESALE in Malappuram, and founder Jabir T."
  image="/epso-food-products-kerala-mixture-snacks-biscuits.webp"
  imageAlt="Epso blog articles on Kerala mixtures, home care, Epso Marketing, and Jabir T"
  structuredData={blogSchema}
>
  <div class="section-pad">
    <div class="container-site">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="mb-2 text-brand-800">Epso Blog &amp; Guides</h1>
      <p class="mb-8 text-brand-600 max-w-2xl">
        Practical kitchen and home care guides alongside stories about Epso Marketing, EPSO BAKERY &amp; STATIONERY WHOLESALE in Cherukulamba, Malappuram, and founder Jabir T.
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {unifiedPosts.map((post) => (
          <article class="card group overflow-hidden flex flex-col">
            <a href={`/blog/${post.slug}/`} class="block" aria-label={post.title}>
              <div class="m-2.5 aspect-video overflow-hidden rounded-xl bg-white/70 border border-white/50">
                {post.sanityImage ? (
                  <SanityImage
                    image={post.sanityImage}
                    alt={post.imageAlt}
                    width={600}
                    height={338}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                ) : (
                  <img
                    src={post.localImage || '/assets/banners/EPSO-Marketing-Truck-on-Globe.webp'}
                    alt={post.imageAlt}
                    title={post.imageTitle}
                    width="600"
                    height="338"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
                  />
                )}
              </div>
            </a>
            <div class="p-5 pt-3 flex-1 flex flex-col">
              <div class="flex flex-wrap items-center gap-2 mb-2">
                {post.category && (
                  <span class="text-[11px] font-semibold uppercase tracking-wider text-brand-800 bg-brand-100 px-2.5 py-0.5 rounded-full">
                    {post.category}
                  </span>
                )}
                {post.publishedAt && (
                  <time class="text-xs font-semibold text-amber-900 bg-amber-500/15 px-2.5 py-0.5 rounded-full inline-block" datetime={post.publishedAt}>
                    {new Date(post.publishedAt).toLocaleDateString('en-IN', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </time>
                )}
              </div>
              <h2 class="mt-1 mb-2 text-base font-semibold text-brand-900 leading-snug group-hover:text-[#eb8d35] transition-colors">
                <a href={`/blog/${post.slug}/`}>
                  {post.title}
                </a>
              </h2>
              {post.excerpt && (
                <p class="text-sm text-brand-600 line-clamp-2 leading-relaxed mb-4 flex-1">{post.excerpt}</p>
              )}
              <a
                href={`/blog/${post.slug}/`}
                class="group mt-auto inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-brand-800 hover:text-[#eb8d35] transition-colors"
              >
                <span>Read article</span>
                <ArrowButton as="span" direction="right" size="sm" color="#0f1420" hoverColor="#eb8d35" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
