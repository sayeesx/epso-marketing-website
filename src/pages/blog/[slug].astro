---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import SanityImage from '../../components/ui/SanityImage.astro';
import ArrowButton from '@components/ui/ArrowButton.astro';
import { sanityClient, sanityImageUrl } from '../../lib/sanity';
import { getBlogPostBySlugQuery, getAllBlogSlugsQuery } from '../../lib/queries';
import { localBlogPosts, type LocalBlogPost } from '../../data/blogPosts';
import { getSiteUrl } from '../../lib/siteUrl';
import type { BlogPost } from '../../types/index';

export async function getStaticPaths() {
  const paths = new Set<string>(localBlogPosts.map((p) => p.slug));
  try {
    const slugs = await sanityClient.fetch<{ slug: string }[]>(getAllBlogSlugsQuery);
    for (const s of slugs || []) {
      if (s?.slug) paths.add(s.slug);
    }
  } catch {
    // Sanity not configured; static paths still generated from localBlogPosts
  }
  return Array.from(paths).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
let sanityPost: BlogPost | null = null;
try {
  sanityPost = await sanityClient.fetch(getBlogPostBySlugQuery, { slug });
} catch {
  // Fallback to local blog post
}

const localPost: LocalBlogPost | undefined = localBlogPosts.find((p) => p.slug === slug);

if (!sanityPost && !localPost) {
  return Astro.redirect('/404');
}

const siteUrl = getSiteUrl(Astro.site);
const title = sanityPost?.title || localPost!.title;
const seoTitle = sanityPost?.seo?.title || localPost?.seoTitle || title;
const description = sanityPost?.seo?.description || sanityPost?.excerpt || localPost?.description || '';
const publishedAt = sanityPost?.publishedAt || localPost?.publishedAt;
const updatedAt = localPost?.updatedAt || publishedAt;
const imageAlt = localPost?.imageAlt || title;
const imageTitle = localPost?.imageTitle || title;

const postImageUrl = sanityPost?.mainImage?.asset?._ref
  ? sanityImageUrl(sanityPost.mainImage, { width: 1200, height: 630 })
  : `${siteUrl}${localPost?.image || '/assets/banners/EPSO-Marketing-Truck-on-Globe.webp'}`;

const articleSchema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    image: {
      '@type': 'ImageObject',
      url: postImageUrl,
      contentUrl: postImageUrl,
      caption: imageAlt,
    },
    datePublished: publishedAt,
    dateModified: updatedAt,
    author: {
      '@type': 'Person',
      name: localPost?.author || 'Jabir T',
    },
    publisher: {
      '@id': `${siteUrl}/#organization`,
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': `${siteUrl}/blog/${slug}/`,
    },
    keywords: localPost?.keywords?.join(', '),
  },
  ...(localPost?.faqs?.length
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: localPost.faqs.map((faq) => ({
            '@type': 'Question',
            name: faq.question,
            acceptedAnswer: {
              '@type': 'Answer',
              text: faq.answer,
            },
          })),
        },
      ]
    : []),
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog/' },
  { label: title, href: `/blog/${slug}/` },
];

const relatedLocalPosts = localBlogPosts.filter((p) => p.slug !== slug).slice(0, 2);

interface PortableTextSpan {
  _type?: string;
  text?: string;
  marks?: string[];
}

interface PortableTextBlock {
  _type?: string;
  style?: string;
  listItem?: string;
  children?: PortableTextSpan[];
  asset?: { _ref?: string; _type?: string };
  alt?: string;
}

const sanityBodyBlocks = Array.isArray(sanityPost?.body)
  ? (sanityPost.body as PortableTextBlock[])
  : [];

function getBlockText(block: PortableTextBlock): string {
  return (block.children || []).map((c) => c.text || '').join('');
}
---
<BaseLayout
  title={seoTitle}
  description={description}
  image={sanityPost?.seo?.ogImage || sanityPost?.mainImage || postImageUrl}
  imageAlt={imageAlt}
  type="article"
  keywords={localPost?.keywords}
  publishedTime={publishedAt}
  modifiedTime={updatedAt}
  structuredData={articleSchema}
>
  <div class="section-pad">
    <div class="container-site">
      <Breadcrumbs items={breadcrumbs} />
      <article class="mx-auto max-w-2xl">
        <div class="flex flex-wrap items-center gap-2.5 mb-2">
          {localPost?.category && (
            <span class="text-xs font-semibold uppercase tracking-wider text-brand-800 bg-brand-100 px-3 py-1 rounded-full">
              {localPost.category}
            </span>
          )}
          {publishedAt && (
            <time class="text-sm text-brand-500" datetime={publishedAt}>
              {new Date(publishedAt).toLocaleDateString('en-IN', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
          )}
          {localPost?.readTime && (
            <span class="text-sm text-brand-400">&bull; {localPost.readTime}</span>
          )}
        </div>

        <h1 class="mt-2 mb-6 text-brand-900 tracking-tight">{title}</h1>

        {(sanityPost?.mainImage || localPost?.image) && (
          <div class="mb-8 aspect-video overflow-hidden rounded-2xl border border-white/80 bg-white/70 backdrop-blur-md p-2 shadow-glass">
            {sanityPost?.mainImage ? (
              <SanityImage
                image={sanityPost.mainImage}
                alt={imageAlt}
                width={800}
                height={450}
                loading="eager"
                fetchpriority="high"
                class="h-full w-full object-cover rounded-xl"
              />
            ) : (
              <img
                src={localPost!.image}
                alt={imageAlt}
                title={imageTitle}
                width="800"
                height="450"
                loading="eager"
                fetchpriority="high"
                class="h-full w-full object-cover object-top rounded-xl"
              />
            )}
          </div>
        )}

        <div class="text-brand-700 leading-relaxed space-y-6">
          {(sanityPost?.excerpt || localPost?.excerpt) && (
            <p class="text-lg font-medium text-brand-800">
              {sanityPost?.excerpt || localPost?.excerpt}
            </p>
          )}

          {localPost?.quickAnswer && (
            <div class="rounded-2xl border border-amber-400/40 bg-amber-50/70 p-5">
              <p class="text-xs font-bold uppercase tracking-wider text-amber-900 mb-1">Quick summary</p>
              <p class="text-sm text-brand-900 leading-relaxed">{localPost.quickAnswer}</p>
            </div>
          )}

          {sanityBodyBlocks.length > 0 ? (
            <div class="space-y-4">
              {sanityBodyBlocks.map((block) => {
                if (block._type === 'image' && block.asset?._ref) {
                  return (
                    <div class="my-4 overflow-hidden rounded-2xl border border-brand-200/70 bg-white p-1.5">
                      <img
                        src={sanityImageUrl(block as unknown as Parameters<typeof sanityImageUrl>[0], { width: 800, format: 'webp' })}
                        alt={block.alt || title}
                        width="800"
                        height="450"
                        loading="lazy"
                        class="w-full h-auto rounded-xl object-cover"
                      />
                    </div>
                  );
                }
                const text = getBlockText(block).trim();
                if (!text) return null;
                if (block.listItem === 'bullet') {
                  return (
                    <ul class="list-disc pl-5 text-brand-700">
                      <li>{text}</li>
                    </ul>
                  );
                }
                if (block.style === 'h2') {
                  return <h2 class="text-xl font-bold text-brand-900 pt-2">{text}</h2>;
                }
                if (block.style === 'h3') {
                  return <h3 class="text-lg font-semibold text-brand-900 pt-1">{text}</h3>;
                }
                if (block.style === 'blockquote') {
                  return (
                    <blockquote class="rounded-2xl border border-amber-400/40 bg-amber-50/70 p-4 text-sm text-brand-900 leading-relaxed">
                      {text}
                    </blockquote>
                  );
                }
                return <p class="text-base text-brand-700 leading-relaxed">{text}</p>;
              })}
            </div>
          ) : localPost ? (
            <>
              {localPost.sections.map((section) => (
                <section class="space-y-3">
                  <h2 class="text-xl font-bold text-brand-900 pt-2">{section.heading}</h2>
                  {section.paragraphs.map((para) => (
                    <p class="text-base text-brand-700 leading-relaxed">{para}</p>
                  ))}
                  {section.bullets && section.bullets.length > 0 && (
                    <ul class="list-disc pl-5 space-y-2 text-brand-700">
                      {section.bullets.map((bullet) => (
                        <li>{bullet}</li>
                      ))}
                    </ul>
                  )}
                </section>
              ))}

              {localPost.faqs.length > 0 && (
                <section class="pt-4 space-y-3">
                  <h2 class="text-xl font-bold text-brand-900">Common questions</h2>
                  {localPost.faqs.map((faq) => (
                    <div class="glass-panel p-4">
                      <h3 class="text-base font-semibold text-brand-900">{faq.question}</h3>
                      <p class="mt-1 text-sm text-brand-600 leading-relaxed">{faq.answer}</p>
                    </div>
                  ))}
                </section>
              )}
            </>
          ) : (
            <p class="text-brand-500 text-sm">No article content available yet.</p>
          )}
        </div>

        {relatedLocalPosts.length > 0 && (
          <section class="mt-12 pt-8 border-t border-brand-200">
            <h2 class="text-lg font-bold text-brand-900 mb-4">More from Epso</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {relatedLocalPosts.map((rel) => (
                <a href={`/blog/${rel.slug}/`} class="glass-panel p-4 hover:border-brand-300 transition-colors block">
                  <p class="text-xs font-semibold text-amber-900 mb-1">{rel.category}</p>
                  <h3 class="text-sm font-bold text-brand-900 leading-snug">{rel.title}</h3>
                </a>
              ))}
            </div>
          </section>
        )}

        <div class="mt-10 pt-6 border-t border-brand-200">
          <a href="/blog/" class="group btn-secondary inline-flex items-center gap-2 pl-2">
            <ArrowButton as="span" direction="left" size="sm" color="#1a202c" hoverColor="#eb8d35" />
            <span>Back to blog</span>
          </a>
        </div>
      </article>
    </div>
  </div>
</BaseLayout>
