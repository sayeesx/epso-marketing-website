---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import SanityImage from '../../components/ui/SanityImage.astro';
import { sanityClient, sanityImageUrl } from '../../lib/sanity';
import { getBlogPostBySlugQuery, getAllBlogSlugsQuery } from '../../lib/queries';
import type { BlogPost } from '../../types/index';

export async function getStaticPaths() {
  try {
    const slugs = await sanityClient.fetch(getAllBlogSlugsQuery);
    return (slugs as { slug: string }[]).map((s) => ({ params: { slug: s.slug } }));
  } catch {
    return [];
  }
}

const { slug } = Astro.params;
let post: BlogPost | null = null;

try {
  post = await sanityClient.fetch(getBlogPostBySlugQuery, { slug });
} catch {
  // Could not fetch post
}

if (!post) {
  return Astro.redirect('/404');
}

const siteUrl = import.meta.env.SITE_URL || 'https://epso.in';
const postImageUrl = post.mainImage?.asset?._ref
  ? sanityImageUrl(post.mainImage, { width: 1200, height: 630 })
  : `${siteUrl}/assets/banners/hero-placeholder.svg`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.excerpt || '',
  image: postImageUrl,
  datePublished: post.publishedAt,
  publisher: {
    '@type': 'Organization',
    name: 'Epso',
    logo: `${siteUrl}/assets/branding/logo-placeholder.svg`,
  },
};

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog/' },
  { label: post.title, href: `/blog/${slug}/` },
];
---
<BaseLayout
  title={post.seo?.title || post.title}
  description={post.seo?.description || post.excerpt || ''}
  image={post.seo?.ogImage || post.mainImage || postImageUrl}
  type="article"
  structuredData={articleSchema}
>
  <div class="section-pad">
    <div class="container-site">
      <Breadcrumbs items={breadcrumbs} />
      <article class="mx-auto max-w-2xl">
        {post.publishedAt && (
          <time class="text-sm text-brand-400" datetime={post.publishedAt}>
            {new Date(post.publishedAt).toLocaleDateString('en-IN', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
        )}
        <h1 class="mt-2 mb-6 text-brand-800">{post.title}</h1>
        {post.mainImage && (
          <div class="mb-8 aspect-video overflow-hidden rounded-xl bg-brand-50">
            <SanityImage
              image={post.mainImage}
              alt={post.title}
              width={800}
              height={450}
              loading="eager"
              class="h-full w-full object-cover"
            />
          </div>
        )}
        <div class="text-brand-600 leading-relaxed space-y-4">
          {post.excerpt && (
            <p class="text-lg font-medium text-brand-700">{post.excerpt}</p>
          )}
          <!-- Full Portable Text body — install @portabletext/astro for rich text rendering -->
          <!-- pnpm add @portabletext/astro -->
          <p class="text-brand-400 text-sm italic border border-brand-100 rounded p-4">
            [Article body — install @portabletext/astro and configure PortableText renderer to display full content]
          </p>
        </div>
      </article>
    </div>
  </div>
</BaseLayout>

