---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhosphorIcon from '../components/ui/PhosphorIcon.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Epso',
};
---
<BaseLayout
  title="Contact Us"
  description="Have a question about Epso products? Get in touch with us."
  structuredData={schema}
>
  <div class="section-pad">
    <div class="container-site">
      <div class="mx-auto max-w-xl">
        <h1 class="mb-2 text-brand-800">Contact us</h1>
        <p class="mb-8 text-brand-500">Have a question? We are happy to help.</p>

        <div class="glass-panel border-amber-500/25 bg-amber-500/10 p-5 mb-8">
          <p class="text-sm text-amber-900 font-medium flex items-center gap-2">
            <PhosphorIcon name="note-pencil" size={18} class="text-amber-800 flex-shrink-0" />
            <span>This contact form is a placeholder. Configure your WhatsApp number or email in .env and implement your preferred contact method here.</span>
          </p>
        </div>

        <div class="glass-panel p-6 sm:p-8 shadow-glass">
          <form
            name="contact"
            method="POST"
            class="space-y-5"
            aria-label="Contact form"
          >
            <div>
              <label for="name" class="mb-1.5 block text-sm font-semibold text-brand-800">
                Your name
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                class="w-full rounded-xl border border-brand-200/80 bg-white/90 px-4 py-2.5 text-sm text-brand-900 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20 backdrop-blur-xs"
                placeholder="Enter your name"
              />
            </div>
            <div>
              <label for="phone" class="mb-1.5 block text-sm font-semibold text-brand-800">
                Phone number
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                autocomplete="tel"
                class="w-full rounded-xl border border-brand-200/80 bg-white/90 px-4 py-2.5 text-sm text-brand-900 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20 backdrop-blur-xs"
                placeholder="+91 XXXXX XXXXX"
              />
            </div>
            <div>
              <label for="email" class="mb-1.5 block text-sm font-semibold text-brand-800">
                Email address
              </label>
              <input
                type="email"
                id="email"
                name="email"
                autocomplete="email"
                class="w-full rounded-xl border border-brand-200/80 bg-white/90 px-4 py-2.5 text-sm text-brand-900 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20 backdrop-blur-xs"
                placeholder="your@email.com"
              />
            </div>
            <div>
              <label for="message" class="mb-1.5 block text-sm font-semibold text-brand-800">
                Your message
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                class="w-full rounded-xl border border-brand-200/80 bg-white/90 px-4 py-2.5 text-sm text-brand-900 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20 resize-none backdrop-blur-xs"
                placeholder="Tell us what you need..."
              ></textarea>
            </div>
            <button type="submit" class="btn-accent w-full py-3 text-base font-semibold">Send message</button>
          </form>
        </div>

        <div class="mt-8 glass-panel p-6">
          <h2 class="mb-3 text-sm font-bold text-brand-900 uppercase tracking-wider">Other ways to reach us</h2>
          <div class="space-y-3 text-sm text-brand-700">
            <p class="flex items-start gap-2.5">
              <PhosphorIcon name="map-pin" size={18} class="text-amber-700 flex-shrink-0 mt-0.5" />
              <span>Location: <strong class="text-brand-900">EPSO BAKERY &amp; STATIONERY WHOLESALE</strong>, Cherukulamba, Malappuram district, Kerala (Wholesale &amp; retail supplier)</span>
            </p>
            <p class="flex items-center gap-2.5">
              <PhosphorIcon name="phone" size={18} class="text-amber-700 flex-shrink-0" />
              <span>Phone: <a href="tel:+919809665188" class="font-semibold text-brand-900 hover:underline">+91 98096 65188</a></span>
            </p>
            <p class="flex items-center gap-2.5">
              <PhosphorIcon name="envelope-simple" size={18} class="text-amber-700 flex-shrink-0" />
              <span>Email: <em>[To be updated]</em></span>
            </p>
            <p class="flex items-center gap-2.5">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="#25D366" class="flex-shrink-0" aria-hidden="true">
                <path d="M12.031 2c-5.516 0-9.969 4.453-9.969 9.969 0 1.766.469 3.484 1.344 5l-1.406 5.156 5.281-1.375c1.469.797 3.109 1.219 4.75 1.219 5.516 0 9.969-4.453 9.969-9.969s-4.453-10-9.969-10zm5.813 14.125c-.25.703-1.438 1.344-2 1.422-.531.078-1.203.109-1.953-.125-.453-.141-1.047-.344-1.781-.656-3.125-1.359-5.156-4.531-5.313-4.734-.156-.203-1.266-1.688-1.266-3.219s.797-2.281 1.078-2.594c.281-.313.609-.391.813-.391.203 0 .406 0 .578.016.188.016.438-.078.688.516.25.609.859 2.094.938 2.25.078.156.125.344.016.547-.109.203-.156.328-.313.516-.156.188-.328.422-.469.563-.156.156-.313.328-.141.641.172.313.781 1.297 1.672 2.094 1.156 1.031 2.125 1.359 2.438 1.516.313.156.484.125.672-.078.188-.203.781-.906.984-1.219.203-.313.422-.266.703-.156.281.109 1.813.859 2.125 1.016.313.156.516.234.594.359.078.125.078.734-.172 1.438z"/>
              </svg>
              <span>WhatsApp: <a href="https://wa.me/919809665188" target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-900 hover:underline">+91 98096 65188</a></span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

