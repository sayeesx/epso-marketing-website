---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Privacy Policy"
  description="Epso's privacy policy — how we handle your information."
  noindex={true}
>
  <div class="section-pad">
    <div class="container-site mx-auto max-w-3xl">
      <h1 class="mb-6 text-brand-800">Privacy policy</h1>
      <div class="rounded-lg border border-accent-200 bg-accent-50 p-5 mb-8">
        <p class="text-sm text-accent-700 font-medium">
          📝 Placeholder. Replace with your actual privacy policy before launch. Have it reviewed by a legal professional.
        </p>
      </div>
      <div class="space-y-5 text-brand-600">
        <p>
          This website is operated by Epso. We respect your privacy and are committed to protecting your personal information.
        </p>
        <h2 class="text-brand-800">What information we collect</h2>
        <p>
          We may collect information you provide when you use our contact form, such as your name, phone number and email address.
        </p>
        <h2 class="text-brand-800">How we use your information</h2>
        <p>
          We use the information you provide to respond to your enquiries. We do not sell or share your information with third parties.
        </p>
        <h2 class="text-brand-800">Contact</h2>
        <p>
          If you have questions about this privacy policy, please{' '}
          <a href="/contact/" class="text-accent-600 hover:underline">contact us</a>.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

