    blogTitleInput?.addEventListener('input', () => {
      if (!blogSlugManuallyEdited && !editingBlogIdInput?.value && blogSlugInput && blogTitleInput) {
        blogSlugInput.value = slugify(blogTitleInput.value);
      }
    });
    blogSlugInput?.addEventListener('input', () => {
      blogSlugManuallyEdited = true;
    });

    blogImageInput?.addEventListener('change', () => {
      const file = blogImageInput.files?.[0];
      if (file && blogImagePreview) {
        blogImagePreview.src = URL.createObjectURL(file);
        if (blogImageAltInput && !blogImageAltInput.value && blogTitleInput?.value) {
          blogImageAltInput.value = blogTitleInput.value;
        }
      }
