    function showToast(msg: string, type: 'success' | 'error' | 'info' = 'info') {
      if (!toastEl) return;
      toastEl.textContent = msg;
      toastEl.className = 'mb-6 rounded-2xl border px-4 py-3 text-sm font-medium';
      if (type === 'success') {
        toastEl.classList.add('border-green-200', 'bg-green-50', 'text-green-900');
      } else if (type === 'error') {
        toastEl.classList.add('border-red-200', 'bg-red-50', 'text-red-900');
      } else {
        toastEl.classList.add('border-amber-200', 'bg-amber-50', 'text-amber-900');
      }
      toastEl.classList.remove('hidden');
      window.setTimeout(() => toastEl.classList.add('hidden'), 6000);
    }

    function slugify(str: string): string {
      return str
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')
        .slice(0, 96);
    }

    function randomKey(): string {
      return Math.random().toString(36).slice(2, 10);
    }

    async function apiCall<T>(action: string, options: RequestInit = {}): Promise<T> {
      const res = await fetch(`/api/admin?action=${encodeURIComponent(action)}`, {
        credentials: 'same-origin',
        ...options,
      });
      const data = (await res.json()) as T & { error?: string };
      if (!res.ok) {
        if (res.status === 401 && action !== 'login' && action !== 'session') {
          showLoginView();
        }
        throw new Error(data.error || `Request failed (${res.status})`);
      }
      return data;
    }

    function showLoginView() {
      dashboardView?.classList.add('hidden');
      dashboardView?.classList.remove('grid');
      blogView?.classList.add('hidden');
      blogView?.classList.remove('grid');
      topbarActions?.classList.add('hidden');
      topbarActions?.classList.remove('flex');
      loginView?.classList.remove('hidden');
    }

    function switchTab(tab: 'products' | 'blog') {
      activeTab = tab;
      const activeCls = 'rounded-full bg-brand-900 text-white px-4 py-1.5 text-sm font-semibold transition-colors';
      const inactiveCls = 'rounded-full border border-brand-300 bg-white text-brand-800 px-4 py-1.5 text-sm font-semibold hover:bg-brand-50 transition-colors';
      if (tab === 'products') {
        dashboardView?.classList.remove('hidden');
        dashboardView?.classList.add('grid');
        blogView?.classList.add('hidden');
        blogView?.classList.remove('grid');
        if (tabProductsBtn) tabProductsBtn.className = activeCls;
        if (tabBlogBtn) tabBlogBtn.className = inactiveCls;
      } else {
        blogView?.classList.remove('hidden');
        blogView?.classList.add('grid');
        dashboardView?.classList.add('hidden');
        dashboardView?.classList.remove('grid');
        if (tabBlogBtn) tabBlogBtn.className = activeCls;
        if (tabProductsBtn) tabProductsBtn.className = inactiveCls;
      }
    }

    function showDashboardView(email?: string) {
      loginView?.classList.add('hidden');
      topbarActions?.classList.remove('hidden');
      topbarActions?.classList.add('flex');
      switchTab(activeTab);
      if (userLabel && email) {
        userLabel.textContent = email;
      }
    }

    tabProductsBtn?.addEventListener('click', () => switchTab('products'));
    tabBlogBtn?.addEventListener('click', () => switchTab('blog'));

    function addSizeRow(size = '', unit = 'g') {
      if (!sizesList) return;
      const row = document.createElement('div');
      row.className = 'flex items-center gap-2 size-row';
      row.innerHTML = `
        <input type="text" placeholder="Size (e.g. 200)" value="${size.replace(/"/g, '&quot;')}" class="size-val w-1/2 rounded-xl border border-brand-300 bg-white px-3 py-1.5 text-xs text-brand-950 focus:border-[#eb8d35] focus:outline-none" />
        <input type="text" placeholder="Unit (g/ml/kg)" value="${unit.replace(/"/g, '&quot;')}" class="size-unit w-1/3 rounded-xl border border-brand-300 bg-white px-3 py-1.5 text-xs text-brand-950 focus:border-[#eb8d35] focus:outline-none" />
        <button type="button" class="btn-remove-size text-xs font-semibold text-red-600 hover:underline px-1">Remove</button>
      `;
      row.querySelector('.btn-remove-size')?.addEventListener('click', () => row.remove());
      sizesList.appendChild(row);
    }

    function resetForm() {
      if (!productForm) return;
      productForm.reset();
      if (editingIdInput) editingIdInput.value = '';
      if (existingImgRefInput) existingImgRefInput.value = '';
      if (imagePreview) imagePreview.src = '/assets/products/product-placeholder.svg';
      if (publishedCheckbox) publishedCheckbox.checked = true;
      if (featuredCheckbox) featuredCheckbox.checked = false;
      if (formHeading) formHeading.textContent = 'Upload New Product';
      if (btnSaveProduct) btnSaveProduct.textContent = 'Save & Upload Product';
      btnResetForm?.classList.add('hidden');
      if (sizesList) {
        sizesList.innerHTML = '';
        addSizeRow('100', 'g');
      }
    }

    let slugManuallyEdited = false;
    nameInput?.addEventListener('input', () => {
      if (!slugManuallyEdited && !editingIdInput?.value && slugInput && nameInput) {
        slugInput.value = slugify(nameInput.value);
      }
    });
    slugInput?.addEventListener('input', () => {
      slugManuallyEdited = true;
    });

    imageInput?.addEventListener('change', () => {
      const file = imageInput.files?.[0];
      if (file && imagePreview) {
        imagePreview.src = URL.createObjectURL(file);
        if (imageAltInput && !imageAltInput.value && nameInput?.value) {
          imageAltInput.value = nameInput.value;
        }
      }
    });

