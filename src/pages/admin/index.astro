    btnResetBlog?.addEventListener('click', () => resetBlogForm());

    function blocksToMarkdown(blocks: AdminBlogBlock[] = []): string {
      return blocks
        .map((block) => {
          const text = (block.children || []).map((c) => c.text || '').join('').trim();
          if (!text) return '';
          if (block.listItem === 'bullet') return `- ${text}`;
          if (block.style === 'h2') return `## ${text}`;
          if (block.style === 'h3') return `### ${text}`;
          if (block.style === 'blockquote') return `> ${text}`;
          return text;
        })
        .filter(Boolean)
        .join('\n\n');
    }

    function markdownToBlocks(text: string) {
      const lines = text.split(/\r?\n/);
      const blocks: Array<Record<string, unknown>> = [];
      let buffer: string[] = [];

      const flushBuffer = () => {
        if (buffer.length === 0) return;
        const para = buffer.join(' ').trim();
        if (para) {
          blocks.push({
            _type: 'block',
            _key: randomKey(),
            style: 'normal',
            markDefs: [],
            children: [{ _type: 'span', _key: randomKey(), text: para, marks: [] }],
          });
        }
        buffer = [];
      };

      for (const rawLine of lines) {
        const line = rawLine.trim();
        if (!line) {
          flushBuffer();
          continue;
        }
        if (line.startsWith('### ')) {
          flushBuffer();
          blocks.push({
            _type: 'block',
            _key: randomKey(),
            style: 'h3',
            markDefs: [],
            children: [{ _type: 'span', _key: randomKey(), text: line.slice(4).trim(), marks: [] }],
          });
        } else if (line.startsWith('## ')) {
          flushBuffer();
          blocks.push({
            _type: 'block',
            _key: randomKey(),
            style: 'h2',
            markDefs: [],
            children: [{ _type: 'span', _key: randomKey(), text: line.slice(3).trim(), marks: [] }],
          });
        } else if (line.startsWith('- ') || line.startsWith('* ')) {
          flushBuffer();
          blocks.push({
            _type: 'block',
            _key: randomKey(),
            style: 'normal',
            listItem: 'bullet',
            level: 1,
            markDefs: [],
            children: [{ _type: 'span', _key: randomKey(), text: line.slice(2).trim(), marks: [] }],
          });
        } else if (line.startsWith('> ')) {
          flushBuffer();
          blocks.push({
            _type: 'block',
            _key: randomKey(),
            style: 'blockquote',
            markDefs: [],
            children: [{ _type: 'span', _key: randomKey(), text: line.slice(2).trim(), marks: [] }],
          });
        } else {
          buffer.push(line);
        }
      }
      flushBuffer();
      return blocks;
    }

    function renderBlogs() {
      if (!blogsList || !blogsCount) return;
      blogsCount.textContent = `${blogPosts.length} blog article${blogPosts.length === 1 ? '' : 's'} stored in Sanity`;

      if (blogPosts.length === 0) {
        blogsList.innerHTML =
          '<p class="py-12 text-center text-sm text-brand-500">No blog articles in Sanity yet. Write one on the left or click "+ Import Built-in Articles" to edit the existing site articles.</p>';
        return;
      }

      blogsList.innerHTML = '';
      blogPosts.forEach((b) => {
        const slugStr = typeof b.slug === 'string' ? b.slug : b.slug?.current || '';
        const card = document.createElement('div');
        card.className = 'flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-2xl border border-brand-200 p-4 hover:border-brand-300 transition-colors';
        const imgUrl = b.imageUrl ? `${b.imageUrl}?w=200&h=120&fit=crop&auto=format` : '/assets/banners/EPSO-Marketing-Truck-on-Globe.webp';
        const dateLabel = b.publishedAt
          ? new Date(b.publishedAt).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' })
          : 'Unscheduled';

        card.innerHTML = `
          <div class="flex items-center gap-3.5 min-w-0">
            <img src="${imgUrl}" alt="${b.title.replace(/"/g, '&quot;')}" class="h-14 w-20 flex-shrink-0 rounded-xl border border-brand-100 bg-brand-50 object-cover" />
            <div class="min-w-0">
              <h3 class="font-semibold text-sm text-brand-950 truncate">${b.title}</h3>
              <p class="text-xs text-brand-500 mt-0.5 truncate">${dateLabel} &middot; /blog/${slugStr}/</p>
            </div>
          </div>
          <div class="flex flex-wrap items-center gap-2 flex-shrink-0">
            <button type="button" data-action="edit-blog" class="rounded-full border border-brand-300 bg-white px-3 py-1 text-xs font-semibold text-brand-800 hover:bg-brand-50">Edit</button>
            <button type="button" data-action="delete-blog" class="rounded-full border border-red-200 bg-white px-3 py-1 text-xs font-semibold text-red-600 hover:bg-red-50">Delete</button>
          </div>
        `;

        card.querySelector('[data-action="edit-blog"]')?.addEventListener('click', () => populateBlogForEdit(b));
        card.querySelector('[data-action="delete-blog"]')?.addEventListener('click', () => deleteBlog(b));
        blogsList.appendChild(card);
      });
    }

    function populateBlogForEdit(b: AdminBlogPost) {
      blogSlugManuallyEdited = true;
      if (editingBlogIdInput) editingBlogIdInput.value = b._id;
      if (existingBlogImgRefInput) existingBlogImgRefInput.value = b.mainImage?.asset?._ref || '';
      if (blogTitleInput) blogTitleInput.value = b.title || '';
      if (blogSlugInput) blogSlugInput.value = typeof b.slug === 'string' ? b.slug : b.slug?.current || '';
      if (blogDateInput) {
        blogDateInput.value = b.publishedAt ? b.publishedAt.slice(0, 10) : '';
      }
      if (blogImageInput) blogImageInput.value = '';
      if (blogImagePreview) {
        blogImagePreview.src = b.imageUrl ? `${b.imageUrl}?w=400&auto=format` : '/assets/banners/EPSO-Marketing-Truck-on-Globe.webp';
      }
      if (blogImageAltInput) blogImageAltInput.value = b.mainImage?.alt || b.title || '';
      if (blogExcerptInput) blogExcerptInput.value = b.excerpt || '';
      if (blogBodyInput) blogBodyInput.value = blocksToMarkdown(b.body || []);
      if (blogSeoTitleInput) blogSeoTitleInput.value = b.seo?.title || '';
      if (blogSeoDescInput) blogSeoDescInput.value = b.seo?.description || '';
      if (blogFormHeading) blogFormHeading.textContent = `Editing: ${b.title}`;
      if (btnSaveBlog) btnSaveBlog.textContent = 'Update Blog Article';
      btnResetBlog?.classList.remove('hidden');
      blogForm?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    async function deleteBlog(b: AdminBlogPost) {
      if (!window.confirm(`Delete article "${b.title}" permanently from Sanity?`)) return;
      try {
        await apiCall('deleteBlog', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: b._id }),
        });
        showToast(`Deleted "${b.title}".`, 'success');
        if (editingBlogIdInput?.value === b._id) resetBlogForm();
        await loadData();
      } catch (err) {
        showToast(err instanceof Error ? err.message : 'Delete failed', 'error');
      }
    }

    btnSeedBlogs?.addEventListener('click', async () => {
      btnSeedBlogs.disabled = true;
      try {
        const res = await apiCall<{ created: number }>('importDefaultBlogs', { method: 'POST' });
        showToast(
          res.created > 0
            ? `Imported ${res.created} built-in blog article${res.created === 1 ? '' : 's'} into Sanity!`
            : 'All built-in articles are already in Sanity.',
          res.created > 0 ? 'success' : 'info'
        );
        await loadData();
      } catch (err) {
        showToast(err instanceof Error ? err.message : 'Import failed', 'error');
      } finally {
        btnSeedBlogs.disabled = false;
      }
    });

    blogForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!btnSaveBlog) return;

      const title = blogTitleInput?.value.trim() || '';
      const slugVal = slugify(blogSlugInput?.value || title);
      if (!title || !slugVal) {
        showToast('Please enter a valid article title and URL slug.', 'error');
        return;
      }

      btnSaveBlog.disabled = true;
      const originalText = btnSaveBlog.textContent || 'Save';
      btnSaveBlog.textContent = 'Saving to Sanity...';

      try {
        let imageAssetRef = existingBlogImgRefInput?.value || '';
        const newFile = blogImageInput?.files?.[0];
        if (newFile) {
          const fd = new FormData();
          fd.append('file', newFile);
          const uploaded = await apiCall<{ assetId?: string }>('upload', {
            method: 'POST',
            body: fd,
          });
          if (uploaded.assetId) imageAssetRef = uploaded.assetId;
        }

        const bodyBlocks = markdownToBlocks(blogBodyInput?.value || '');
        const dateVal = blogDateInput?.value;
        const publishedAt = dateVal ? `${dateVal}T09:00:00.000Z` : new Date().toISOString();

        const payload: Record<string, unknown> = {
          title,
          slug: { _type: 'slug', current: slugVal },
          publishedAt,
          excerpt: blogExcerptInput?.value.trim() || undefined,
          body: bodyBlocks.length > 0 ? bodyBlocks : undefined,
        };

        const seoTitle = blogSeoTitleInput?.value.trim();
        const seoDesc = blogSeoDescInput?.value.trim();
        if (seoTitle || seoDesc) {
          payload.seo = {
            ...(seoTitle ? { title: seoTitle } : {}),
            ...(seoDesc ? { description: seoDesc } : {}),
          };
        }

        if (imageAssetRef) {
          payload.mainImage = {
            _type: 'image',
            asset: { _type: 'reference', _ref: imageAssetRef },
            alt: blogImageAltInput?.value.trim() || title,
          };
        }

        const editingId = editingBlogIdInput?.value;
        await apiCall('saveBlog', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ editingId: editingId || undefined, payload }),
        });

        showToast(editingId ? `Updated "${title}" in Sanity!` : `Published "${title}" to Sanity!`, 'success');
        resetBlogForm();
        await loadData();
      } catch (err) {
        showToast(err instanceof Error ? err.message : 'Failed to save blog article.', 'error');
      } finally {
        btnSaveBlog.disabled = false;
        btnSaveBlog.textContent = originalText;
      }
    });

    // Check active session on page load
    apiCall<{ authenticated: boolean; email?: string }>('session')
      .then((res) => {
        if (res.authenticated) {
          showDashboardView(res.email);
          resetForm();
          resetBlogForm();
          loadData();
        }
      })
      .catch(() => {
        showLoginView();
      });
  </script>
  </body>
</html>
