    function resetBlogForm() {
      if (!blogForm) return;
      blogForm.reset();
      if (editingBlogIdInput) editingBlogIdInput.value = '';
      if (existingBlogImgRefInput) existingBlogImgRefInput.value = '';
      if (blogImagePreview) blogImagePreview.src = '/assets/banners/EPSO-Marketing-Truck-on-Globe.webp';
      if (blogDateInput) blogDateInput.value = new Date().toISOString().slice(0, 10);
      if (blogFormHeading) blogFormHeading.textContent = 'Write New Article';
      if (btnSaveBlog) btnSaveBlog.textContent = 'Save & Publish Article';
      btnResetBlog?.classList.add('hidden');
      blogSlugManuallyEdited = false;
