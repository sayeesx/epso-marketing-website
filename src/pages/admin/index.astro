---
import SEO from '@components/seo/SEO.astro';
import '@/styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <SEO
      title="Admin"
      description="Epso product management admin portal for internal catalogue updates."
      noindex={true}
    />
  </head>
  <body class="min-h-screen bg-brand-50/40 text-brand-800 font-sans antialiased">
    <main class="min-h-screen w-full px-4 py-8 sm:px-6 lg:px-8">
      <div class="mx-auto w-full max-w-6xl">
        <!-- Global feedback banner -->
        <div id="admin-toast" class="hidden mx-auto mb-6 max-w-md rounded-2xl border px-4 py-3 text-sm font-medium" role="status" aria-live="polite"></div>

        <!-- STEP 1: EMAIL & PASSWORD SIGN IN (Standalone, no navbar/footer/branding text) -->
        <div id="admin-login-view" class="mx-auto mt-[14vh] max-w-md rounded-3xl border border-brand-200 bg-white p-6 sm:p-8 shadow-sm">
          <h1 class="text-xl font-bold text-brand-950 mb-5">Sign in</h1>

          <form id="login-form" class="space-y-4">
            <div>
              <label for="login-email" class="block text-sm font-semibold text-brand-900 mb-1.5">
                Email
              </label>
              <input
                id="login-email"
                type="text"
                inputmode="email"
                required
                autocomplete="username"
                placeholder="Enter email"
                class="w-full rounded-xl border border-brand-300 bg-white px-4 py-2.5 text-sm text-brand-950 focus:border-[#eb8d35] focus:outline-none"
              />
            </div>

            <div>
              <label for="login-password" class="block text-sm font-semibold text-brand-900 mb-1.5">
                Password
              </label>
              <input
                id="login-password"
                type="password"
                required
                autocomplete="current-password"
                placeholder="Enter password"
                class="w-full rounded-xl border border-brand-300 bg-white px-4 py-2.5 text-sm text-brand-950 focus:border-[#eb8d35] focus:outline-none"
              />
            </div>

            <button id="btn-connect" type="submit" class="btn-primary w-full py-3 text-sm font-semibold">
              Sign in
            </button>
          </form>
        </div>

        <!-- Admin actions top bar (only visible after login) -->
        <div id="admin-topbar-actions" class="hidden mb-6 flex-wrap items-center justify-between gap-4 border-b border-brand-200 pb-4">
          <div class="flex items-center gap-2">
            <button
              id="tab-products"
              type="button"
              class="rounded-full bg-brand-900 text-white px-4 py-1.5 text-sm font-semibold transition-colors"
            >
              Products
            </button>
            <button
              id="tab-blog"
              type="button"
              class="rounded-full border border-brand-300 bg-white text-brand-800 px-4 py-1.5 text-sm font-semibold hover:bg-brand-50 transition-colors"
            >
              Blog
            </button>
          </div>
          <div class="flex items-center gap-3">
            <span id="admin-user-label" class="text-xs font-medium text-brand-600"></span>
            <button
              id="btn-sign-out"
              type="button"
              class="btn-secondary text-xs px-4 py-2"
            >
              Sign out
            </button>
          </div>
        </div>

        <!-- STEP 2: MAIN PRODUCT DASHBOARD -->
        <div id="admin-dashboard-view" class="hidden grid-cols-1 gap-8 lg:grid-cols-12">
        <!-- Left column: Upload / Edit Product Form -->
        <div class="lg:col-span-5">
          <div class="rounded-3xl border border-brand-200 bg-white p-6 sm:p-7">
            <div class="mb-5 flex items-center justify-between gap-2">
              <h2 id="form-heading" class="text-lg font-bold text-brand-950">Upload New Product</h2>
              <button id="btn-reset-form" type="button" class="hidden text-xs font-semibold text-[#eb8d35] hover:underline">
                Cancel edit
              </button>
            </div>

            <form id="product-form" class="space-y-4">
              <input type="hidden" id="editing-product-id" value="" />
              <input type="hidden" id="existing-image-ref" value="" />

              <!-- Product Name -->
              <div>
                <label for="prod-name" class="block text-xs font-bold uppercase tracking-wider text-brand-700 mb-1.5">
                  Product Name *
                </label>
                <input
                  id="prod-name"
                  type="text"
                  required
                  minlength="2"
                  maxlength="100"
                  placeholder="e.g. Epso Kerala Mixture"
                  class="w-full rounded-xl border border-brand-300 bg-white px-3.5 py-2.5 text-sm text-brand-950 focus:border-[#eb8d35] focus:outline-none"
                />
              </div>

              <!-- Slug -->
              <div>
                <label for="prod-slug" class="block text-xs font-bold uppercase tracking-wider text-brand-700 mb-1.5">
                  URL Slug *
                </label>
                <input
                  id="prod-slug"
                  type="text"
                  required
                  placeholder="epso-kerala-mixture"
                  class="w-full rounded-xl border border-brand-300 bg-brand-50/50 px-3.5 py-2 text-xs font-mono text-brand-800 focus:border-[#eb8d35] focus:outline-none"
                />
              </div>

              <!-- Category -->
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <label for="prod-category" class="block text-xs font-bold uppercase tracking-wider text-brand-700">
                    Category
                  </label>
                  <button
                    id="btn-quick-categories"
                    type="button"
                    class="text-[11px] font-semibold text-[#eb8d35] hover:underline"
                  >
                    + Ensure Food &amp; Home Care
                  </button>
                </div>
                <select
                  id="prod-category"
                  class="w-full rounded-xl border border-brand-300 bg-white px-3.5 py-2.5 text-sm text-brand-950 focus:border-[#eb8d35] focus:outline-none"
                >
                  <option value="">Select category...</option>
                </select>
              </div>

              <!-- Image Upload -->
              <div>
                <label for="prod-image" class="block text-xs font-bold uppercase tracking-wider text-brand-700 mb-1.5">
                  Product Image
                </label>
                <div class="flex items-center gap-4">
                  <div class="h-20 w-20 flex-shrink-0 overflow-hidden rounded-2xl border border-brand-200 bg-brand-50 flex items-center justify-center">
                    <img
                      id="prod-image-preview"
                      src="/assets/products/product-placeholder.svg"
                      alt="Product preview"
                      class="h-full w-full object-contain p-1"
                    />
                  </div>
                  <div class="flex-1">
                    <input
                      id="prod-image"
                      type="file"
                      accept="image/png,image/jpeg,image/webp,image/avif"
                      class="block w-full text-xs text-brand-600 file:mr-3 file:rounded-full file:border file:border-brand-300 file:bg-white file:px-3.5 file:py-1.5 file:text-xs file:font-semibold file:text-brand-800 hover:file:bg-brand-50 cursor-pointer"
                    />
                    <p class="mt-1 text-[11px] text-brand-500">Square PNG/WebP/JPG recommended (min 800×800px).</p>
                  </div>
                </div>
              </div>

              <!-- Image Alt -->
              <div>
                <label for="prod-image-alt" class="block text-xs font-bold uppercase tracking-wider text-brand-700 mb-1.5">
                  Image Description (Alt Text)
                </label>
                <input
                  id="prod-image-alt"
                  type="text"
                  placeholder="e.g. Epso Kerala Mixture 200g pack"
                  class="w-full rounded-xl border border-brand-300 bg-white px-3.5 py-2 text-sm text-brand-950 focus:border-[#eb8d35] focus:outline-none"
                />
              </div>

              <!-- Short Description -->
              <div>
                <label for="prod-short-desc" class="block text-xs font-bold uppercase tracking-wider text-brand-700 mb-1.5">
                  Short Description
                </label>
                <textarea
                  id="prod-short-desc"
                  rows="2"
                  maxlength="200"
                  placeholder="Crispy traditional Kerala mixture made for everyday tea-time."
                  class="w-full rounded-xl border border-brand-300 bg-white px-3.5 py-2 text-sm text-brand-950 focus:border-[#eb8d35] focus:outline-none resize-none"
                ></textarea>
              </div>

              <!-- Full Description -->
              <div>
                <label for="prod-full-desc" class="block text-xs font-bold uppercase tracking-wider text-brand-700 mb-1.5">
                  Full Description
                </label>
                <textarea
                  id="prod-full-desc"
                  rows="3"
                  placeholder="Detailed product information shown on the product page..."
                  class="w-full rounded-xl border border-brand-300 bg-white px-3.5 py-2 text-sm text-brand-950 focus:border-[#eb8d35] focus:outline-none"
                ></textarea>
              </div>

              <!-- Pack Sizes -->
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <label class="block text-xs font-bold uppercase tracking-wider text-brand-700">
                    Pack Sizes
                  </label>
                  <button id="btn-add-size" type="button" class="text-[11px] font-semibold text-[#eb8d35] hover:underline">
                    + Add size
                  </button>
                </div>
                <div id="sizes-list" class="space-y-2"></div>
              </div>

              <!-- Key Features -->
              <div>
                <label for="prod-features" class="block text-xs font-bold uppercase tracking-wider text-brand-700 mb-1.5">
                  Key Features <span class="font-normal text-brand-400">(one per line)</span>
                </label>
                <textarea
                  id="prod-features"
                  rows="3"
                  placeholder="Freshly packed&#10;No artificial colours&#10;Resealable pouch"
                  class="w-full rounded-xl border border-brand-300 bg-white px-3.5 py-2 text-sm text-brand-950 focus:border-[#eb8d35] focus:outline-none"
                ></textarea>
              </div>

              <!-- Ingredients & Usage -->
              <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <div>
                  <label for="prod-ingredients" class="block text-xs font-bold uppercase tracking-wider text-brand-700 mb-1.5">
                    Ingredients
                  </label>
                  <textarea
                    id="prod-ingredients"
                    rows="2"
                    placeholder="Optional (for food)"
                    class="w-full rounded-xl border border-brand-300 bg-white px-3.5 py-2 text-xs text-brand-950 focus:border-[#eb8d35] focus:outline-none"
                  ></textarea>
                </div>
                <div>
                  <label for="prod-usage" class="block text-xs font-bold uppercase tracking-wider text-brand-700 mb-1.5">
                    Usage Instructions
                  </label>
                  <textarea
                    id="prod-usage"
                    rows="2"
                    placeholder="Optional (for home care)"
                    class="w-full rounded-xl border border-brand-300 bg-white px-3.5 py-2 text-xs text-brand-950 focus:border-[#eb8d35] focus:outline-none"
                  ></textarea>
                </div>
              </div>

              <!-- Checkboxes -->
              <div class="flex flex-wrap items-center gap-5 pt-1">
                <label class="flex items-center gap-2 text-sm font-medium text-brand-800 cursor-pointer select-none">
                  <input id="prod-published" type="checkbox" checked class="rounded border-brand-300 text-[#eb8d35] focus:ring-[#eb8d35]" />
                  <span>Published</span>
                </label>
                <label class="flex items-center gap-2 text-sm font-medium text-brand-800 cursor-pointer select-none">
                  <input id="prod-featured" type="checkbox" class="rounded border-brand-300 text-[#eb8d35] focus:ring-[#eb8d35]" />
                  <span>Feature on homepage</span>
                </label>
              </div>

              <button id="btn-save-product" type="submit" class="btn-primary w-full py-3 text-sm font-semibold">
                Save &amp; Upload Product
              </button>
            </form>
          </div>
        </div>

        <!-- Right column: Live Product List from Sanity -->
        <div class="lg:col-span-7">
          <div class="rounded-3xl border border-brand-200 bg-white p-6 sm:p-7">
            <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
              <div>
                <h2 class="text-lg font-bold text-brand-950">Products in Sanity</h2>
                <p id="products-count" class="text-xs text-brand-500 mt-0.5">Loading...</p>
              </div>
              <button id="btn-refresh" type="button" class="btn-secondary text-xs px-4 py-1.5">
                Refresh
              </button>
            </div>

            <div id="products-list" class="space-y-3">
              <p class="py-12 text-center text-sm text-brand-400">Loading products from Sanity...</p>
            </div>
          </div>
        </div>
      </div>

      <!-- STEP 3: BLOG MANAGEMENT DASHBOARD -->
      <div id="admin-blog-view" class="hidden grid-cols-1 gap-8 lg:grid-cols-12">
        <!-- Left column: Create / Edit Blog Form -->
        <div class="lg:col-span-5">
          <div class="rounded-3xl border border-brand-200 bg-white p-6 sm:p-7">
            <div class="mb-5 flex items-center justify-between gap-2">
              <h2 id="blog-form-heading" class="text-lg font-bold text-brand-950">Write New Article</h2>
              <button id="btn-reset-blog" type="button" class="hidden text-xs font-semibold text-[#eb8d35] hover:underline">
                Cancel edit
              </button>
            </div>

            <form id="blog-form" class="space-y-4">
              <input type="hidden" id="editing-blog-id" value="" />
              <input type="hidden" id="existing-blog-image-ref" value="" />

              <div>
                <label for="blog-title" class="block text-xs font-bold uppercase tracking-wider text-brand-700 mb-1.5">
                  Article Title *
                </label>
                <input
                  id="blog-title"
                  type="text"
                  required
                  minlength="5"
                  maxlength="120"
                  placeholder="e.g. Kerala Mixture & Everyday Snacks by Epso"
                  class="w-full rounded-xl border border-brand-300 bg-white px-3.5 py-2.5 text-sm text-brand-950 focus:border-[#eb8d35] focus:outline-none"
                />
              </div>

              <div>
                <label for="blog-slug" class="block text-xs font-bold uppercase tracking-wider text-brand-700 mb-1.5">
                  URL Slug *
                </label>
                <input
                  id="blog-slug"
                  type="text"
                  required
                  placeholder="kerala-mixture-everyday-snacks"
                  class="w-full rounded-xl border border-brand-300 bg-brand-50/50 px-3.5 py-2 text-xs font-mono text-brand-800 focus:border-[#eb8d35] focus:outline-none"
                />
              </div>

              <div>
                <label for="blog-date" class="block text-xs font-bold uppercase tracking-wider text-brand-700 mb-1.5">
                  Published Date
                </label>
                <input
                  id="blog-date"
                  type="date"
                  class="w-full rounded-xl border border-brand-300 bg-white px-3.5 py-2 text-sm text-brand-950 focus:border-[#eb8d35] focus:outline-none"
                />
              </div>

              <div>
                <label for="blog-image" class="block text-xs font-bold uppercase tracking-wider text-brand-700 mb-1.5">
                  Main Image
                </label>
                <div class="flex items-center gap-4">
                  <div class="h-16 w-24 flex-shrink-0 overflow-hidden rounded-xl border border-brand-200 bg-brand-50 flex items-center justify-center">
                    <img
                      id="blog-image-preview"
                      src="/assets/banners/EPSO-Marketing-Truck-on-Globe.webp"
                      alt="Blog image preview"
                      class="h-full w-full object-cover"
                    />
                  </div>
                  <div class="flex-1">
                    <input
                      id="blog-image"
                      type="file"
                      accept="image/png,image/jpeg,image/webp,image/avif"
                      class="block w-full text-xs text-brand-600 file:mr-3 file:rounded-full file:border file:border-brand-300 file:bg-white file:px-3.5 file:py-1.5 file:text-xs file:font-semibold file:text-brand-800 hover:file:bg-brand-50 cursor-pointer"
                    />
                    <p class="mt-1 text-[11px] text-brand-500">1200×630 or 16:9 WebP/PNG/JPG recommended.</p>
                  </div>
                </div>
              </div>

              <div>
                <label for="blog-image-alt" class="block text-xs font-bold uppercase tracking-wider text-brand-700 mb-1.5">
                  Image Alt Text
                </label>
                <input
                  id="blog-image-alt"
                  type="text"
                  placeholder="Describe the article image for search engines"
                  class="w-full rounded-xl border border-brand-300 bg-white px-3.5 py-2 text-sm text-brand-950 focus:border-[#eb8d35] focus:outline-none"
                />
              </div>

              <div>
                <label for="blog-excerpt" class="block text-xs font-bold uppercase tracking-wider text-brand-700 mb-1.5">
                  Short Summary (Excerpt)
                </label>
                <textarea
                  id="blog-excerpt"
                  rows="2"
                  maxlength="300"
                  placeholder="Short summary shown on the blog listing page..."
                  class="w-full rounded-xl border border-brand-300 bg-white px-3.5 py-2 text-sm text-brand-950 focus:border-[#eb8d35] focus:outline-none resize-none"
                ></textarea>
              </div>

              <div>
                <label for="blog-body" class="block text-xs font-bold uppercase tracking-wider text-brand-700 mb-1.5">
                  Article Content <span class="font-normal text-brand-400">(use ## Heading, - Bullet, blank line for paragraphs)</span>
                </label>
                <textarea
                  id="blog-body"
                  rows="8"
                  placeholder="## Why Epso snacks stand out&#10;&#10;Write your article paragraphs here...&#10;&#10;- Bullet point one&#10;- Bullet point two"
                  class="w-full rounded-xl border border-brand-300 bg-white px-3.5 py-2 text-sm text-brand-950 focus:border-[#eb8d35] focus:outline-none"
                ></textarea>
              </div>

              <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <div>
                  <label for="blog-seo-title" class="block text-xs font-bold uppercase tracking-wider text-brand-700 mb-1.5">
                    SEO Title
                  </label>
                  <input
                    id="blog-seo-title"
                    type="text"
                    maxlength="60"
                    placeholder="Optional (max 60 chars)"
                    class="w-full rounded-xl border border-brand-300 bg-white px-3.5 py-2 text-xs text-brand-950 focus:border-[#eb8d35] focus:outline-none"
                  />
                </div>
                <div>
                  <label for="blog-seo-desc" class="block text-xs font-bold uppercase tracking-wider text-brand-700 mb-1.5">
                    SEO Description
                  </label>
                  <input
                    id="blog-seo-desc"
                    type="text"
                    maxlength="160"
                    placeholder="Optional (max 160 chars)"
                    class="w-full rounded-xl border border-brand-300 bg-white px-3.5 py-2 text-xs text-brand-950 focus:border-[#eb8d35] focus:outline-none"
                  />
                </div>
              </div>

              <button id="btn-save-blog" type="submit" class="btn-primary w-full py-3 text-sm font-semibold">
                Save &amp; Publish Article
              </button>
            </form>
          </div>
        </div>

        <!-- Right column: Blog Articles in Sanity -->
        <div class="lg:col-span-7">
          <div class="rounded-3xl border border-brand-200 bg-white p-6 sm:p-7">
            <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
              <div>
                <h2 class="text-lg font-bold text-brand-950">Blog Articles in Sanity</h2>
                <p id="blogs-count" class="text-xs text-brand-500 mt-0.5">Loading...</p>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <button id="btn-seed-blogs" type="button" class="text-xs font-semibold text-[#eb8d35] hover:underline px-2 py-1">
                  + Import Built-in Articles
                </button>
                <button id="btn-refresh-blogs" type="button" class="btn-secondary text-xs px-4 py-1.5">
                  Refresh
                </button>
              </div>
            </div>

            <div id="blogs-list" class="space-y-3">
              <p class="py-12 text-center text-sm text-brand-400">Loading blog articles from Sanity...</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    </main>

  <script>
    interface SizeEntry {
      _key?: string;
      size: string;
      unit: string;
      description?: string;
    }

    interface AdminProduct {
      _id: string;
      name: string;
      slug?: { current?: string } | string;
      isPublished?: boolean;
      isFeatured?: boolean;
      category?: { _id: string; name: string } | null;
      mainImage?: {
        _type: 'image';
        asset?: { _ref?: string; _type?: 'reference' };
        alt?: string;
      };
      imageUrl?: string;
      shortDescription?: string;
      description?: Array<{ children?: Array<{ text?: string }> }>;
      packagingSizes?: SizeEntry[];
      features?: Array<{ _key?: string; feature: string }>;
      ingredients?: string;
      usageInstructions?: string;
    }

    interface AdminCategory {
      _id: string;
      name: string;
      slug?: string;
    }

    interface AdminBlogBlock {
      _type?: string;
      style?: string;
      listItem?: string;
      children?: Array<{ text?: string }>;
    }

    interface AdminBlogPost {
      _id: string;
      title: string;
      slug?: { current?: string } | string;
      publishedAt?: string;
      excerpt?: string;
      body?: AdminBlogBlock[];
      mainImage?: {
        _type: 'image';
        asset?: { _ref?: string; _type?: 'reference' };
        alt?: string;
      };
      imageUrl?: string;
      seo?: {
        title?: string;
        description?: string;
      };
    }

    let categories: AdminCategory[] = [];
    let products: AdminProduct[] = [];
    let blogPosts: AdminBlogPost[] = [];
    let activeTab: 'products' | 'blog' = 'products';

    const loginView = document.getElementById('admin-login-view') as HTMLElement | null;
    const dashboardView = document.getElementById('admin-dashboard-view') as HTMLElement | null;
    const blogView = document.getElementById('admin-blog-view') as HTMLElement | null;
    const tabProductsBtn = document.getElementById('tab-products') as HTMLButtonElement | null;
    const tabBlogBtn = document.getElementById('tab-blog') as HTMLButtonElement | null;
    const topbarActions = document.getElementById('admin-topbar-actions') as HTMLElement | null;
    const userLabel = document.getElementById('admin-user-label') as HTMLElement | null;
    const toastEl = document.getElementById('admin-toast') as HTMLElement | null;

    const loginForm = document.getElementById('login-form') as HTMLFormElement | null;
    const emailInput = document.getElementById('login-email') as HTMLInputElement | null;
    const passwordInput = document.getElementById('login-password') as HTMLInputElement | null;
    const btnConnect = document.getElementById('btn-connect') as HTMLButtonElement | null;
    const btnSignOut = document.getElementById('btn-sign-out') as HTMLButtonElement | null;

    const productForm = document.getElementById('product-form') as HTMLFormElement | null;
    const formHeading = document.getElementById('form-heading') as HTMLElement | null;
    const btnResetForm = document.getElementById('btn-reset-form') as HTMLButtonElement | null;
    const editingIdInput = document.getElementById('editing-product-id') as HTMLInputElement | null;
    const existingImgRefInput = document.getElementById('existing-image-ref') as HTMLInputElement | null;

    const nameInput = document.getElementById('prod-name') as HTMLInputElement | null;
    const slugInput = document.getElementById('prod-slug') as HTMLInputElement | null;
    const categorySelect = document.getElementById('prod-category') as HTMLSelectElement | null;
    const imageInput = document.getElementById('prod-image') as HTMLInputElement | null;
    const imagePreview = document.getElementById('prod-image-preview') as HTMLImageElement | null;
    const imageAltInput = document.getElementById('prod-image-alt') as HTMLInputElement | null;
    const shortDescInput = document.getElementById('prod-short-desc') as HTMLTextAreaElement | null;
    const fullDescInput = document.getElementById('prod-full-desc') as HTMLTextAreaElement | null;
    const featuresInput = document.getElementById('prod-features') as HTMLTextAreaElement | null;
    const ingredientsInput = document.getElementById('prod-ingredients') as HTMLTextAreaElement | null;
    const usageInput = document.getElementById('prod-usage') as HTMLTextAreaElement | null;
    const publishedCheckbox = document.getElementById('prod-published') as HTMLInputElement | null;
    const featuredCheckbox = document.getElementById('prod-featured') as HTMLInputElement | null;

    const sizesList = document.getElementById('sizes-list') as HTMLElement | null;
    const btnAddSize = document.getElementById('btn-add-size') as HTMLButtonElement | null;
