---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCta from '../components/sections/ContactCta.astro';
---
<BaseLayout
  title="Quality and Standards"
  description="Epso's commitment to quality in every product we make."
>
  <div class="section-pad">
    <div class="container-site mx-auto max-w-3xl">
      <h1 class="mb-6 text-brand-800">Quality and standards</h1>

      <div class="rounded-lg border border-accent-200 bg-accent-50 p-5 mb-8">
        <p class="text-sm text-accent-700 font-medium">
          📝 Placeholder content. Update with actual quality certifications, standards and manufacturing details once available.
        </p>
      </div>

      <div class="space-y-6 text-brand-600">
        <p>
          At Epso, we care about the quality of every product we make. This page will describe our quality standards and processes in detail.
        </p>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div class="rounded-lg border border-brand-100 p-5">
            <h2 class="mb-2 text-base font-semibold text-brand-800">Food products</h2>
            <p class="text-sm text-brand-500">
              Details about food safety, ingredients and production standards — coming soon.
            </p>
          </div>
          <div class="rounded-lg border border-brand-100 p-5">
            <h2 class="mb-2 text-base font-semibold text-brand-800">Home care products</h2>
            <p class="text-sm text-brand-500">
              Details about cleaning product safety, ingredients and standards — coming soon.
            </p>
          </div>
        </div>

        <div class="rounded-lg bg-brand-50 p-5">
          <h2 class="mb-3 font-semibold text-brand-800">Certifications</h2>
          <p class="text-sm text-brand-500">
            Certification details will be listed here once confirmed.
          </p>
        </div>
      </div>
    </div>
  </div>
  <ContactCta heading="Have questions about our products?" />
</BaseLayout>

