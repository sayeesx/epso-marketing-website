---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCta from '../components/sections/ContactCta.astro';
import PhosphorIcon from '../components/ui/PhosphorIcon.astro';
---
<BaseLayout
  title="Quality and Standards"
  description="Epso's commitment to quality in every product we make."
>
  <div class="section-pad">
    <div class="container-site mx-auto max-w-3xl">
      <h1 class="mb-6 text-brand-800">Quality and standards</h1>

      <div class="glass-panel border-amber-500/25 bg-amber-500/10 p-5 mb-8">
        <p class="text-sm text-amber-900 font-medium flex items-center gap-2">
          <PhosphorIcon name="note-pencil" size={18} class="text-amber-800 flex-shrink-0" />
          <span>Placeholder content. Update with actual quality certifications, standards and manufacturing details once available.</span>
        </p>
      </div>

      <div class="space-y-6 text-brand-700 leading-relaxed">
        <p class="text-lg text-brand-900">
          At Epso, we care about the quality of every product we make. This page will describe our quality standards and processes in detail.
        </p>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div class="glass-panel p-6">
            <h2 class="mb-2 text-lg font-bold text-brand-900">Food products</h2>
            <p class="text-sm text-brand-600 leading-relaxed">
              Details about food safety, ingredients and production standards — coming soon.
            </p>
          </div>
          <div class="glass-panel p-6">
            <h2 class="mb-2 text-lg font-bold text-brand-900">Home care products</h2>
            <p class="text-sm text-brand-600 leading-relaxed">
              Details about cleaning product safety, ingredients and standards — coming soon.
            </p>
          </div>
        </div>

        <div class="glass-panel p-6">
          <h2 class="mb-3 font-bold text-brand-900 text-lg">Certifications</h2>
          <p class="text-sm text-brand-600 leading-relaxed">
            Certification details will be listed here once confirmed.
          </p>
        </div>
      </div>
    </div>
  </div>
  <ContactCta heading="Have questions about our products?" />
</BaseLayout>

