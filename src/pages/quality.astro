---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Quality', href: '/quality/' },
];
---
<BaseLayout
  title="Quality and Standards"
  description="Epso's commitment to quality in every everyday food and home care product we supply across Kerala."
>
  <div class="section-pad">
    <div class="container-site mx-auto max-w-3xl">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="mb-6 text-brand-800">Quality and standards</h1>

      <div class="space-y-6 text-brand-700 leading-relaxed">
        <p class="text-lg text-brand-900">
          At Epso, we care about the consistency and reliability of every product we supply from Cherukulamba, Malappuram district, Kerala.
        </p>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div class="glass-panel p-6">
            <h2 class="mb-2 text-lg font-bold text-brand-900">Food products</h2>
            <p class="text-sm text-brand-600 leading-relaxed">
              Our Kerala mixtures, tea-time snacks, and biscuits are packed in clean, sealed packs designed to preserve freshness for everyday family use.
            </p>
          </div>
          <div class="glass-panel p-6">
            <h2 class="mb-2 text-lg font-bold text-brand-900">Home care products</h2>
            <p class="text-sm text-brand-600 leading-relaxed">
              Our dishwashing liquids, floor cleaners, and household cleaning products undergo batch checks and hygienic packing before reaching retailers and homes.
            </p>
          </div>
        </div>

        <div class="glass-panel p-6">
          <h2 class="mb-3 font-bold text-brand-900 text-lg">Quality checks &amp; enquiries</h2>
          <p class="text-sm text-brand-600 leading-relaxed">
            Every batch supplied through EPSO BAKERY &amp; STATIONERY WHOLESALE is checked before packing and dispatch. For product specifications or wholesale documentation, contact{' '}
            <a href="mailto:hello@epso.in" class="font-semibold text-brand-900 hover:underline">hello@epso.in</a> or{' '}
            <a href="mailto:sales@epso.in" class="font-semibold text-brand-900 hover:underline">sales@epso.in</a>.
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
