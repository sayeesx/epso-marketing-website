---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import SanityImage from '../../components/ui/SanityImage.astro';
import ProductCard from '../../components/ui/ProductCard.astro';
import PhosphorIcon from '../../components/ui/PhosphorIcon.astro';
import ArrowButton from '@components/ui/ArrowButton.astro';
import { sanityClient, sanityImageUrl } from '../../lib/sanity';
import { getSiteUrl } from '../../lib/siteUrl';
import { getProductBySlugQuery, getAllProductSlugsQuery } from '../../lib/queries';
import type { Product } from '../../types/index';

export async function getStaticPaths() {
  try {
    const slugs = await sanityClient.fetch(getAllProductSlugsQuery);
    return (slugs as { slug: string }[]).map((s) => ({ params: { slug: s.slug } }));
  } catch {
    return [];
  }
}

const { slug } = Astro.params;
let product: Product | null = null;

try {
  product = await sanityClient.fetch(getProductBySlugQuery, { slug });
} catch {
  // Could not fetch product
}

if (!product) {
  return Astro.redirect('/404');
}

const catSlug =
  typeof product.category?.slug === 'string'
    ? product.category.slug
    : product.category?.slug?.current;

const parentSlug =
  typeof product.category?.parent?.slug === 'string'
    ? product.category.parent.slug
    : product.category?.parent?.slug?.current;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Products', href: '/products/' },
  ...(product.category?.parent && parentSlug
    ? [{ label: product.category.parent.name, href: `/products/?category=${parentSlug}` }]
    : []),
  ...(product.category && catSlug
    ? [{ label: product.category.name, href: `/products/?category=${catSlug}` }]
    : []),
  { label: product.name, href: `/products/${slug}/` },
];

const siteUrl = getSiteUrl(Astro.site);
const productImageUrl = product.mainImage?.asset?._ref
  ? sanityImageUrl(product.mainImage, { width: 800, height: 800 })
  : `${siteUrl}/assets/products/product-placeholder.svg`;

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.shortDescription || product.seo?.description || '',
  image: productImageUrl,
  brand: {
    '@type': 'Brand',
    name: 'Epso',
    logo: `${siteUrl}/logo.png`,
  },
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    seller: {
      '@type': 'Organization',
      name: 'Epso',
      logo: `${siteUrl}/logo.png`,
    },
  },
};
---
<BaseLayout
  title={product.seo?.title || product.name}
  description={product.seo?.description || product.shortDescription || `${product.name} by Epso.`}
  image={product.seo?.ogImage || product.mainImage || productImageUrl}
  type="product"
  structuredData={productSchema}
>
  <div class="section-pad">
    <div class="container-site">
      <Breadcrumbs items={breadcrumbs} />

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:gap-12">
        <!-- Product images -->
        <div>
          <div class="aspect-square overflow-hidden rounded-2xl border border-white/80 bg-white/70 backdrop-blur-md shadow-glass p-2">
            <SanityImage
              image={product.mainImage}
              alt={product.mainImage?.alt || product.name}
              width={600}
              height={600}
              loading="eager"
              fetchpriority="high"
              class="h-full w-full object-cover rounded-xl"
            />
          </div>
          {product.images && product.images.length > 0 && (
            <div class="mt-3 grid grid-cols-4 gap-2">
              {product.images.slice(0, 4).map((img) => (
                <div class="aspect-square overflow-hidden rounded-xl border border-white/70 bg-white/70 backdrop-blur-md p-1 shadow-xs">
                  <SanityImage
                    image={img}
                    alt={img.alt || product!.name}
                    width={150}
                    height={150}
                    class="h-full w-full object-cover rounded-lg"
                  />
                </div>
              ))}
            </div>
          )}
        </div>

        <!-- Product info -->
        <div class="glass-panel p-6 sm:p-8 shadow-glass">
          {product.category && catSlug && (
            <a
              href={`/products/?category=${catSlug}`}
              class="mb-3 inline-block text-xs font-semibold uppercase tracking-wider text-amber-900 bg-amber-500/15 px-3 py-1 rounded-full hover:bg-amber-500/25 transition-colors"
            >
              {product.category.name}
            </a>
          )}
          <h1 class="mb-3 text-2xl sm:text-3xl font-bold text-brand-900 tracking-tight">{product.name}</h1>
          {product.shortDescription && (
            <p class="mb-6 text-base sm:text-lg text-brand-600 leading-relaxed">{product.shortDescription}</p>
          )}

          <!-- Packaging sizes -->
          {product.packagingSizes && product.packagingSizes.length > 0 && (
            <div class="mb-6">
              <h2 class="mb-2 text-xs font-bold uppercase tracking-wider text-brand-700">
                Available sizes
              </h2>
              <div class="flex flex-wrap gap-2">
                {product.packagingSizes.map((size) => (
                  <span class="rounded-full border border-white/80 bg-white/90 px-3.5 py-1 text-xs font-semibold text-brand-800 shadow-xs backdrop-blur-xs">
                    {size.size} {size.unit}
                  </span>
                ))}
              </div>
            </div>
          )}

          <!-- Features -->
          {product.features && product.features.length > 0 && (
            <div class="mb-6">
              <h2 class="mb-2.5 text-xs font-bold uppercase tracking-wider text-brand-700">
                Features
              </h2>
              <ul class="flex flex-col gap-2">
                {product.features.map((f) => (
                  <li class="flex items-start gap-2 text-sm text-brand-700">
                    <PhosphorIcon name="check" size={16} class="mt-0.5 text-success font-bold flex-shrink-0" />
                    <span>{f.feature}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Ingredients -->
          {product.ingredients && (
            <div class="mb-6">
              <h2 class="mb-1.5 text-xs font-bold uppercase tracking-wider text-brand-700">
                Ingredients
              </h2>
              <p class="text-sm text-brand-600 leading-relaxed">{product.ingredients}</p>
            </div>
          )}

          <!-- Usage instructions -->
          {product.usageInstructions && (
            <div class="mb-6">
              <h2 class="mb-1.5 text-xs font-bold uppercase tracking-wider text-brand-700">
                How to use
              </h2>
              <p class="text-sm text-brand-600 leading-relaxed">{product.usageInstructions}</p>
            </div>
          )}

          <!-- CTA -->
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a href="/contact/" class="btn-primary">Enquire about this product</a>
            <a href="/products/" class="group btn-secondary inline-flex items-center gap-2 pl-2">
              <ArrowButton as="span" direction="left" size="sm" color="#1a202c" hoverColor="#eb8d35" />
              <span>Back to products</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Related products -->
      {product.relatedProducts && product.relatedProducts.length > 0 && (
        <div class="mt-16">
          <h2 class="mb-6 text-brand-800">Related products</h2>
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
            {product.relatedProducts.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

