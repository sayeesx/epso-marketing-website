---
interface Props {
  direction?: 'left' | 'right';
  size?: 'lg' | 'md' | 'sm';
  color?: string;
  hoverColor?: string;
  href?: string;
  as?: 'button' | 'a' | 'span';
  ariaLabel?: string;
  class?: string;
}

const {
  direction = 'right',
  size = 'md',
  color = '#000000',
  hoverColor = '#eb8d35',
  href,
  as,
  ariaLabel,
  class: className = '',
} = Astro.props;

const tag = as || (href ? 'a' : 'button');
const scaleMap = {
  lg: { px: 76, scale: 1 },
  md: { px: 48, scale: 48 / 76 },
  sm: { px: 38, scale: 38 / 76 },
};
const { px, scale } = scaleMap[size];

// Left arrow (original) vs Right arrow
const arrowPath =
  direction === 'left'
    ? 'M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z'
    : 'M4 11h12.17l-5.59-5.59L12 4l8 8-8 8-1.41-1.41L16.17 13H4v-2z';
---
<div
  class={`arrow-btn-wrapper inline-block flex-shrink-0 ${className}`}
  style={`width: ${px}px; height: ${px}px; --arrow-color: ${color}; --arrow-hover-color: ${hoverColor}; --btn-scale: ${scale};`}
>
  {tag === 'a' ? (
    <a
      href={href}
      class="arrow-btn"
      data-dir={direction}
      aria-label={ariaLabel}
    >
      <div class="button-box">
        <span class="button-elem">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="arrow-icon" aria-hidden="true">
            <path d={arrowPath} />
          </svg>
        </span>
        <span class="button-elem">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="arrow-icon" aria-hidden="true">
            <path d={arrowPath} />
          </svg>
        </span>
      </div>
    </a>
  ) : tag === 'span' ? (
    <span
      class="arrow-btn"
      data-dir={direction}
      aria-hidden="true"
    >
      <div class="button-box">
        <span class="button-elem">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="arrow-icon">
            <path d={arrowPath} />
          </svg>
        </span>
        <span class="button-elem">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="arrow-icon">
            <path d={arrowPath} />
          </svg>
        </span>
      </div>
    </span>
  ) : (
    <button
      type="button"
      class="arrow-btn"
      data-dir={direction}
      aria-label={ariaLabel}
    >
      <div class="button-box">
        <span class="button-elem">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="arrow-icon" aria-hidden="true">
            <path d={arrowPath} />
          </svg>
        </span>
        <span class="button-elem">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="arrow-icon" aria-hidden="true">
            <path d={arrowPath} />
          </svg>
        </span>
      </div>
    </button>
  )}
</div>

<style>
  .arrow-btn-wrapper {
    position: relative;
    overflow: visible;
  }

  .arrow-btn {
    display: block;
    position: relative;
    width: 76px;
    height: 76px;
    margin: 0;
    overflow: hidden;
    outline: none;
    background-color: transparent;
    cursor: pointer;
    border: 0;
    transform-origin: top left;
    transform: scale(var(--btn-scale, 1));
    text-decoration: none;
  }

  .arrow-btn:before {
    content: "";
    position: absolute;
    border-radius: 50%;
    inset: 7px;
    border: 3px solid var(--arrow-color, black);
    transition:
      opacity 0.4s cubic-bezier(0.77, 0, 0.175, 1) 80ms,
      transform 0.5s cubic-bezier(0.455, 0.03, 0.515, 0.955) 80ms;
  }

  .arrow-btn:after {
    content: "";
    position: absolute;
    border-radius: 50%;
    inset: 7px;
    border: 4px solid var(--arrow-hover-color, #eb8d35);
    transform: scale(1.3);
    transition:
      opacity 0.4s cubic-bezier(0.165, 0.84, 0.44, 1),
      transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    opacity: 0;
  }

  .arrow-btn:hover:before,
  .arrow-btn:focus:before,
  .arrow-btn:active:before,
  :global(.group:hover) .arrow-btn:before,
  :global(.group:active) .arrow-btn:before {
    opacity: 0;
    transform: scale(0.7);
    transition:
      opacity 0.4s cubic-bezier(0.165, 0.84, 0.44, 1),
      transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .arrow-btn:hover:after,
  .arrow-btn:focus:after,
  .arrow-btn:active:after,
  :global(.group:hover) .arrow-btn:after,
  :global(.group:active) .arrow-btn:after {
    opacity: 1;
    transform: scale(1);
    transition:
      opacity 0.4s cubic-bezier(0.77, 0, 0.175, 1) 80ms,
      transform 0.5s cubic-bezier(0.455, 0.03, 0.515, 0.955) 80ms;
  }

  .button-box {
    display: flex;
    position: absolute;
    top: 0;
    left: 0;
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .button-elem {
    display: block;
    width: 30px;
    height: 30px;
    margin: 23px 18px 0 22px;
    fill: var(--arrow-color, black);
  }

  .arrow-icon {
    width: 100%;
    height: 100%;
    display: block;
  }

  .arrow-icon path {
    fill: var(--arrow-color, black);
    transition: fill 0.3s ease;
  }

  .arrow-btn:hover .arrow-icon path,
  .arrow-btn:focus .arrow-icon path,
  .arrow-btn:active .arrow-icon path,
  :global(.group:hover) .arrow-btn .arrow-icon path,
  :global(.group:active) .arrow-btn .arrow-icon path {
    fill: var(--arrow-hover-color, #eb8d35);
  }

  /* Left-pointing arrow slides left on hover/click */
  .arrow-btn[data-dir="left"] .button-box {
    transform: translateX(0px);
  }
  .arrow-btn[data-dir="left"]:hover .button-box,
  .arrow-btn[data-dir="left"]:focus .button-box,
  .arrow-btn[data-dir="left"]:active .button-box,
  :global(.group:hover) .arrow-btn[data-dir="left"] .button-box,
  :global(.group:active) .arrow-btn[data-dir="left"] .button-box {
    transform: translateX(-69px);
  }

  /* Right-pointing arrow starts shifted and slides right on hover/click */
  .arrow-btn[data-dir="right"] .button-box {
    transform: translateX(-69px);
  }
  .arrow-btn[data-dir="right"]:hover .button-box,
  .arrow-btn[data-dir="right"]:focus .button-box,
  .arrow-btn[data-dir="right"]:active .button-box,
  :global(.group:hover) .arrow-btn[data-dir="right"] .button-box,
  :global(.group:active) .arrow-btn[data-dir="right"] .button-box {
    transform: translateX(0px);
  }
</style>

