---
import type { Product } from '../../types/index';
import SanityImage from './SanityImage.astro';

interface Props {
  product: Product;
}
const { product } = Astro.props;
const slug = typeof product.slug === 'string' ? product.slug : product.slug?.current;
---
<article class="card group flex flex-col overflow-hidden">
  <a href={`/products/${slug}/`} class="block overflow-hidden" tabindex="-1" aria-hidden="true">
    <div class="aspect-square overflow-hidden bg-brand-50">
      <SanityImage
        image={product.mainImage}
        alt={product.mainImage?.alt || product.name}
        width={400}
        height={400}
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        placeholderSrc="/assets/products/product-placeholder.svg"
      />
    </div>
  </a>
  <div class="flex flex-1 flex-col p-4">
    {product.category && (
      <span class="mb-1 text-xs font-medium uppercase tracking-wide text-brand-500">
        {product.category.name}
      </span>
    )}
    <h3 class="mb-2 text-base font-semibold text-brand-800 leading-snug">
      <a
        href={`/products/${slug}/`}
        class="hover:text-brand-600 focus-visible:outline focus-visible:outline-2 focus-visible:rounded focus-visible:outline-accent-500"
      >
        {product.name}
      </a>
    </h3>
    {product.shortDescription && (
      <p class="mb-4 flex-1 text-sm text-brand-500 line-clamp-2">{product.shortDescription}</p>
    )}
    <a href={`/products/${slug}/`} class="btn-secondary mt-auto text-sm">
      View details
    </a>
  </div>
</article>

