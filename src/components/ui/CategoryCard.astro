---
import type { Category } from '../../types/index';
import SanityImage from './SanityImage.astro';
import ArrowButton from './ArrowButton.astro';

interface Props {
  category: Category;
  theme?: 'orange' | 'blue' | 'default';
}
const { category, theme } = Astro.props;
const slug = typeof category.slug === 'string' ? category.slug : category.slug?.current;

const isFood = slug === 'food' || slug === 'food-products' || category.name.toLowerCase().includes('food');
const isHomeCare = slug === 'home-care' || slug === 'cleaning' || category.name.toLowerCase().includes('home');

const cardTheme = theme || (isFood ? 'orange' : isHomeCare ? 'blue' : 'default');

const defaultImage = isFood
  ? '/epso_food_product.webp'
  : isHomeCare
  ? '/epso_home_care.webp'
  : `/assets/categories/${slug}-placeholder.svg`;

const imageSrc = category.imageUrl || defaultImage;
---
{cardTheme === 'orange' ? (
  <article class="relative flex flex-col h-full rounded-[28px] overflow-hidden transition-all duration-300 hover:-translate-y-1.5 shadow-[0_14px_36px_rgba(235,98,24,0.22)] hover:shadow-[0_20px_45px_rgba(235,98,24,0.32)] group" style="background: linear-gradient(145deg, #F57827 0%, #EA5C12 100%);">
    <!-- Subtle background accent circle inspired by design reference -->
    <div class="pointer-events-none absolute -top-12 -right-12 w-48 h-48 rounded-full bg-white/10 blur-xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute top-8 left-1/2 -translate-x-1/2 w-64 h-64 rounded-full bg-white/[0.08]" aria-hidden="true"></div>

    <a href={`/products/?category=${slug}`} class="relative z-10 flex flex-col h-full" aria-label={`Browse ${category.name}`}>
      <!-- Image container: Balanced size, accurately fitted, zero cropping (object-contain) -->
      <div class="w-full h-56 sm:h-64 md:h-72 p-2 sm:p-3 flex items-center justify-center">
        {category.image?.asset?._ref && !category.imageUrl ? (
          <SanityImage
            image={category.image}
            alt={category.name}
            width={600}
            height={600}
            class="h-full w-full max-h-full max-w-full object-contain filter drop-shadow-[0_14px_24px_rgba(0,0,0,0.18)] transition-transform duration-500 group-hover:scale-105"
            placeholderSrc={imageSrc}
          />
        ) : (
          <img
            src={imageSrc}
            alt={category.name}
            width="600"
            height="600"
            class="h-full w-full max-h-full max-w-full object-contain filter drop-shadow-[0_14px_24px_rgba(0,0,0,0.18)] transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />
        )}
      </div>

      <!-- Content area -->
      <div class="p-5 pt-1 sm:p-6 sm:pt-1 flex-1 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between gap-3">
            <h3 class="font-bold text-white text-xl sm:text-2xl tracking-tight">
              {category.name}
            </h3>
            <ArrowButton as="span" direction="right" size="md" color="#ffffff" hoverColor="#ffffff" />
          </div>
          {category.description && (
            <p class="mt-2 text-white/90 text-sm sm:text-base leading-relaxed line-clamp-2">
              {category.description}
            </p>
          )}
        </div>
      </div>
    </a>
  </article>
) : cardTheme === 'blue' ? (
  <article class="relative flex flex-col h-full rounded-[28px] overflow-hidden transition-all duration-300 hover:-translate-y-1.5 shadow-[0_14px_36px_rgba(95,134,235,0.28)] hover:shadow-[0_20px_45px_rgba(95,134,235,0.38)] group" style="background: linear-gradient(145deg, #7498F6 0%, #557DE8 100%);">
    <!-- Subtle background accent circle -->
    <div class="pointer-events-none absolute -top-12 -right-12 w-48 h-48 rounded-full bg-white/15 blur-xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute top-8 left-1/2 -translate-x-1/2 w-64 h-64 rounded-full bg-white/10" aria-hidden="true"></div>

    <a href={`/products/?category=${slug}`} class="relative z-10 flex flex-col h-full" aria-label={`Browse ${category.name}`}>
      <!-- Image container: Balanced size, accurately fitted, zero cropping (object-contain) -->
      <div class="w-full h-56 sm:h-64 md:h-72 p-2 sm:p-3 flex items-center justify-center">
        {category.image?.asset?._ref && !category.imageUrl ? (
          <SanityImage
            image={category.image}
            alt={category.name}
            width={600}
            height={600}
            class="h-full w-full max-h-full max-w-full object-contain filter drop-shadow-[0_12px_22px_rgba(0,0,0,0.12)] transition-transform duration-500 group-hover:scale-105"
            placeholderSrc={imageSrc}
          />
        ) : (
          <img
            src={imageSrc}
            alt={category.name}
            width="600"
            height="600"
            class="h-full w-full max-h-full max-w-full object-contain filter drop-shadow-[0_12px_22px_rgba(0,0,0,0.12)] transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />
        )}
      </div>

      <!-- Content area -->
      <div class="p-5 pt-1 sm:p-6 sm:pt-1 flex-1 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between gap-3">
            <h3 class="font-bold text-white text-xl sm:text-2xl tracking-tight">
              {category.name}
            </h3>
            <ArrowButton as="span" direction="right" size="md" color="#ffffff" hoverColor="#ffffff" />
          </div>
          {category.description && (
            <p class="mt-2 text-white/90 text-sm sm:text-base leading-relaxed line-clamp-2">
              {category.description}
            </p>
          )}
        </div>
      </div>
    </a>
  </article>
) : (
  <article class="card group overflow-hidden h-full flex flex-col">
    <a href={`/products/?category=${slug}`} class="flex flex-col h-full" aria-label={`Browse ${category.name}`}>
      <div class="m-2.5 aspect-video overflow-hidden rounded-xl bg-white/70 border border-white/50 flex items-center justify-center p-3">
        {category.image?.asset?._ref && !category.imageUrl ? (
          <SanityImage
            image={category.image}
            alt={category.name}
            width={600}
            height={338}
            class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
            placeholderSrc={imageSrc}
          />
        ) : (
          <img
            src={imageSrc}
            alt={category.name}
            width="600"
            height="338"
            class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />
        )}
      </div>
      <div class="p-5 pt-3 flex-1 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between gap-2">
            <h3 class="font-semibold text-brand-900 group-hover:text-[#eb8d35] transition-colors text-lg">
              {category.name}
            </h3>
            <ArrowButton as="span" direction="right" size="md" color="#0f1420" hoverColor="#eb8d35" />
          </div>
          {category.description && (
            <p class="mt-1.5 text-sm text-brand-600 line-clamp-2 leading-relaxed">{category.description}</p>
          )}
        </div>
      </div>
    </a>
  </article>
)}

