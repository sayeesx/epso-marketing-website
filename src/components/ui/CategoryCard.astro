---
import type { Category } from '../../types/index';
import SanityImage from './SanityImage.astro';

interface Props {
  category: Category;
}
const { category } = Astro.props;
const slug = typeof category.slug === 'string' ? category.slug : category.slug?.current;
---
<article class="card group overflow-hidden">
  <a href={`/category/${slug}/`} class="block" aria-label={`Browse ${category.name}`}>
    <div class="aspect-video overflow-hidden bg-brand-50">
      <SanityImage
        image={category.image}
        alt={category.name}
        width={400}
        height={225}
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        placeholderSrc={`/assets/categories/${slug}-placeholder.svg`}
      />
    </div>
    <div class="p-4">
      <h3 class="font-semibold text-brand-800 group-hover:text-brand-600 transition-colors">
        {category.name}
      </h3>
      {category.description && (
        <p class="mt-1 text-sm text-brand-500 line-clamp-2">{category.description}</p>
      )}
    </div>
  </a>
</article>

