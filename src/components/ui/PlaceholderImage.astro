---
interface Props {
  width: number;
  height: number;
  label?: string;
  class?: string;
  aspectRatio?: string;
}
const { width, height, label = 'Image placeholder', class: className = '', aspectRatio } = Astro.props;
const ratio = aspectRatio || `${width}/${height}`;
---
<div
  class={`placeholder-image ${className}`}
  style={`aspect-ratio: ${ratio}; width: 100%;`}
  role="img"
  aria-label={label}
>
  <div class="flex flex-col items-center gap-1 p-4 text-center">
    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="2"/>
      <circle cx="8.5" cy="8.5" r="1.5"/>
      <polyline points="21 15 16 10 5 21"/>
    </svg>
    <span class="text-xs leading-tight">{label}</span>
  </div>
</div>

