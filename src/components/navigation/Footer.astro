---
const currentYear = new Date().getFullYear();

const footerLinks = {
  Products: [
    { label: 'All Products', href: '/products/' },
    { label: 'Food Products', href: '/products/?category=food' },
    { label: 'Home Care', href: '/products/?category=home-care' },
  ],
  Company: [
    { label: 'About Epso', href: '/about/' },
    { label: 'Quality', href: '/quality/' },
    { label: 'Blog', href: '/blog/' },
  ],
  Help: [
    { label: 'Contact Us', href: '/contact/' },
    { label: 'Privacy Policy', href: '/privacy-policy/' },
  ],
};
---
<footer class="border-t border-neutral-800 bg-black text-white">
  <div class="container-site py-14">
    <div class="grid grid-cols-2 gap-8 lg:grid-cols-4">
      <!-- Brand column -->
      <div class="col-span-2 lg:col-span-1">
        <a href="/" class="inline-flex items-center gap-2.5 mb-4 transition-opacity hover:opacity-90" aria-label="Epso Marketing homepage">
          <img
            src="/epso-marketing-logo-cherukulamba-malappuram-kerala.png"
            alt="Epso Marketing official logo"
            title="Epso Marketing - EPSO BAKERY & STATIONERY WHOLESALE"
            width="560"
            height="548"
            class="h-11 w-auto object-contain"
            loading="lazy"
          />
          <span class="text-base font-bold tracking-wide text-white">Epso Marketing</span>
        </a>
        <p class="text-sm text-neutral-400 leading-relaxed max-w-xs font-normal">
          Good products for every home. Food and home care made for everyday Indian life.
        </p>
        <p class="mt-3 text-xs text-neutral-400 leading-relaxed max-w-xs">
          EPSO BAKERY &amp; STATIONERY WHOLESALE &bull;{' '}
          <a href="https://share.google/xUXNsXc0cXicOHcHz" target="_blank" rel="noopener noreferrer" class="hover:text-white underline underline-offset-2 transition-colors">
            Cherukulamba, Malappuram, Kerala
          </a>
        </p>
        <p class="mt-2 text-xs text-neutral-400 leading-relaxed">
          <a href="mailto:hello@epso.in" class="hover:text-white transition-colors">hello@epso.in</a> &bull;{' '}
          <a href="mailto:sales@epso.in" class="hover:text-white transition-colors">sales@epso.in</a>
        </p>
        <div class="mt-4 flex items-center gap-3">
          <a href="https://wa.me/919809665188" target="_blank" rel="noopener noreferrer" aria-label="Epso WhatsApp" title="WhatsApp" class="text-neutral-400 hover:text-[#25D366] transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M12.031 2c-5.516 0-9.969 4.453-9.969 9.969 0 1.766.469 3.484 1.344 5l-1.406 5.156 5.281-1.375c1.469.797 3.109 1.219 4.75 1.219 5.516 0 9.969-4.453 9.969-9.969s-4.453-10-9.969-10zm5.813 14.125c-.25.703-1.438 1.344-2 1.422-.531.078-1.203.109-1.953-.125-.453-.141-1.047-.344-1.781-.656-3.125-1.359-5.156-4.531-5.313-4.734-.156-.203-1.266-1.688-1.266-3.219s.797-2.281 1.078-2.594c.281-.313.609-.391.813-.391.203 0 .406 0 .578.016.188.016.438-.078.688.516.25.609.859 2.094.938 2.25.078.156.125.344.016.547-.109.203-.156.328-.313.516-.156.188-.328.422-.469.563-.156.156-.313.328-.141.641.172.313.781 1.297 1.672 2.094 1.156 1.031 2.125 1.359 2.438 1.516.313.156.484.125.672-.078.188-.203.781-.906.984-1.219.203-.313.422-.266.703-.156.281.109 1.813.859 2.125 1.016.313.156.516.234.594.359.078.125.078.734-.172 1.438z"/>
            </svg>
          </a>
          <a href="https://www.instagram.com/epso.in" target="_blank" rel="noopener noreferrer" aria-label="Epso Instagram" title="Instagram (@epso.in)" class="text-neutral-400 hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
            </svg>
          </a>
          <a href="https://www.facebook.com/epso" target="_blank" rel="noopener noreferrer" aria-label="Epso Facebook" title="Facebook (facebook.com/epso)" class="text-neutral-400 hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
            </svg>
          </a>
          <a href="https://www.linkedin.com/company/epso" target="_blank" rel="noopener noreferrer" aria-label="Epso LinkedIn" title="LinkedIn (epso)" class="text-neutral-400 hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Link columns: Products & Company side-by-side on mobile, Help centered below on mobile -->
      {Object.entries(footerLinks).map(([heading, links]) => {
        const isHelp = heading === 'Help';
        return (
          <div class={isHelp ? 'col-span-2 text-center lg:col-span-1 lg:text-left' : 'col-span-1'}>
            <h3 class="mb-3.5 text-xs font-bold text-white uppercase tracking-widest">{heading}</h3>
            <ul class={`flex flex-col gap-2.5 ${isHelp ? 'items-center lg:items-start' : ''}`} role="list">
              {links.map((link) => (
                <li>
                  <a href={link.href} class="text-sm text-neutral-400 hover:text-white font-medium transition-colors">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>

    <div class="mt-12 border-t border-neutral-800 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-neutral-500">
        &copy; {currentYear} Epso Marketing. All rights reserved.
      </p>
      <p class="text-xs text-neutral-500">
        Developed by <a href="https://www.narrs.in" target="_blank" rel="noopener noreferrer" class="text-neutral-300 hover:text-white underline underline-offset-2 transition-colors">narrs</a>
      </p>
    </div>
  </div>
</footer>

