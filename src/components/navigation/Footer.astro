---
const currentYear = new Date().getFullYear();

const footerLinks = {
  Products: [
    { label: 'All Products', href: '/products/' },
    { label: 'Food Products', href: '/category/food/' },
    { label: 'Home Care', href: '/category/home-care/' },
  ],
  Company: [
    { label: 'About Epso', href: '/about/' },
    { label: 'Quality', href: '/quality/' },
    { label: 'Blog', href: '/blog/' },
  ],
  Help: [
    { label: 'Contact Us', href: '/contact/' },
    { label: 'Privacy Policy', href: '/privacy-policy/' },
  ],
};
---
<footer class="border-t border-brand-100 bg-brand-50">
  <div class="container-site py-12">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Brand column -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="inline-block mb-4" aria-label="Epso homepage">
          <img
            src="/logo.png"
            alt="Epso"
            width="560"
            height="548"
            class="h-10 w-auto object-contain"
            loading="lazy"
          />
        </a>
        <p class="text-sm text-brand-500 leading-relaxed max-w-xs">
          Good products for every home. Food and home care made for everyday Indian life.
        </p>
      </div>

      <!-- Link columns -->
      {Object.entries(footerLinks).map(([heading, links]) => (
        <div>
          <h3 class="mb-3 text-sm font-semibold text-brand-700 uppercase tracking-wide">{heading}</h3>
          <ul class="flex flex-col gap-2" role="list">
            {links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-brand-500 hover:text-brand-700 transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10 border-t border-brand-200 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-brand-400">
        &copy; {currentYear} Epso. All rights reserved.
      </p>
      <div class="flex gap-4">
        <a href="/privacy-policy/" class="text-xs text-brand-400 hover:text-brand-600">Privacy Policy</a>
      </div>
    </div>
  </div>
</footer>

