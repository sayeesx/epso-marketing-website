---
const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About us', href: '/about/' },
  { label: 'Products', href: '/products/' },
  { label: 'Quality', href: '/quality/' },
  { label: 'Blog', href: '/blog/' },
];

const currentPath = Astro.url.pathname;
---
<header class="sticky top-0 z-50 border-b border-white/60 bg-white/75 backdrop-blur-md shadow-[0_4px_20px_-4px_rgba(0,0,0,0.03)] transition-all duration-300">
  <div class="container-site">
    <nav aria-label="Main navigation" class="flex h-16 items-center justify-between gap-4">
      <!-- Logo -->
      <a href="/" class="flex-shrink-0 transition-opacity hover:opacity-90 flex items-center" aria-label="Epso – go to homepage">
        <img
          src="/logo.png"
          alt="Epso"
          width="560"
          height="548"
          class="h-10 sm:h-11 w-auto object-contain"
          loading="eager"
        />
      </a>

      <!-- Desktop Navigation with active pill/underline styling -->
      <ul class="hidden items-center gap-1.5 md:flex" role="list">
        {navLinks.map((link) => {
          const isActive =
            link.href === '/'
              ? currentPath === '/'
              : currentPath.startsWith(link.href);
          return (
            <li class="relative">
              <a
                href={link.href}
                class={`inline-block px-3.5 py-1.5 text-sm font-medium transition-all duration-150 relative ${
                  isActive
                    ? 'text-brand-950 font-bold'
                    : 'text-brand-700 hover:text-brand-950 hover:bg-black/5 rounded-full'
                }`}
                aria-current={isActive ? 'page' : undefined}
              >
                {link.label}
                {isActive && (
                  <span class="absolute bottom-0 left-3.5 right-3.5 h-0.5 rounded-full bg-accent-600 animate-fade-in" aria-hidden="true" />
                )}
              </a>
            </li>
          );
        })}
      </ul>

      <!-- Desktop Contact Actions -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href="https://wa.me/919809665188"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden lg:inline-flex items-center gap-2 rounded-full border border-brand-900/15 bg-white/80 px-4 py-2 text-xs font-semibold text-brand-900 hover:bg-white hover:border-[#25D366]/60 transition-colors"
          aria-label="Chat on WhatsApp at +91 98096 65188"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="#25D366" aria-hidden="true">
            <path d="M12.031 2c-5.516 0-9.969 4.453-9.969 9.969 0 1.766.469 3.484 1.344 5l-1.406 5.156 5.281-1.375c1.469.797 3.109 1.219 4.75 1.219 5.516 0 9.969-4.453 9.969-9.969s-4.453-10-9.969-10zm5.813 14.125c-.25.703-1.438 1.344-2 1.422-.531.078-1.203.109-1.953-.125-.453-.141-1.047-.344-1.781-.656-3.125-1.359-5.156-4.531-5.313-4.734-.156-.203-1.266-1.688-1.266-3.219s.797-2.281 1.078-2.594c.281-.313.609-.391.813-.391.203 0 .406 0 .578.016.188.016.438-.078.688.516.25.609.859 2.094.938 2.25.078.156.125.344.016.547-.109.203-.156.328-.313.516-.156.188-.328.422-.469.563-.156.156-.313.328-.141.641.172.313.781 1.297 1.672 2.094 1.156 1.031 2.125 1.359 2.438 1.516.313.156.484.125.672-.078.188-.203.781-.906.984-1.219.203-.313.422-.266.703-.156.281.109 1.813.859 2.125 1.016.313.156.516.234.594.359.078.125.078.734-.172 1.438z"/>
          </svg>
          <span>+91 98096 65188</span>
        </a>
        <a href="/contact/" class="btn-primary text-sm px-5 py-2">Contact us</a>
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="flex h-10 w-10 items-center justify-center rounded-full text-brand-700 hover:bg-black/5 md:hidden transition-colors"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open navigation menu"
        type="button"
      >
        <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="hidden">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-white/60 bg-white/95 backdrop-blur-xl animate-slide-down md:hidden shadow-lg"
    aria-label="Mobile navigation"
  >
    <div class="container-site py-4">
      <ul class="flex flex-col gap-1" role="list">
        {navLinks.map((link) => {
          const isActive =
            link.href === '/'
              ? currentPath === '/'
              : currentPath.startsWith(link.href);
          return (
            <li>
              <a
                href={link.href}
                class={`block rounded-xl px-4 py-2.5 text-sm font-medium transition-colors ${
                  isActive
                    ? 'bg-brand-900/10 text-brand-950 font-bold'
                    : 'text-brand-700 hover:bg-black/5 hover:text-brand-900'
                }`}
                aria-current={isActive ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          );
        })}
        <li class="mt-2 pt-2 border-t border-brand-200/50 flex flex-col gap-2">
          <a
            href="https://wa.me/919809665188"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary w-full text-sm text-center inline-flex items-center justify-center gap-2"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="#25D366" aria-hidden="true">
              <path d="M12.031 2c-5.516 0-9.969 4.453-9.969 9.969 0 1.766.469 3.484 1.344 5l-1.406 5.156 5.281-1.375c1.469.797 3.109 1.219 4.75 1.219 5.516 0 9.969-4.453 9.969-9.969s-4.453-10-9.969-10zm5.813 14.125c-.25.703-1.438 1.344-2 1.422-.531.078-1.203.109-1.953-.125-.453-.141-1.047-.344-1.781-.656-3.125-1.359-5.156-4.531-5.313-4.734-.156-.203-1.266-1.688-1.266-3.219s.797-2.281 1.078-2.594c.281-.313.609-.391.813-.391.203 0 .406 0 .578.016.188.016.438-.078.688.516.25.609.859 2.094.938 2.25.078.156.125.344.016.547-.109.203-.156.328-.313.516-.156.188-.328.422-.469.563-.156.156-.313.328-.141.641.172.313.781 1.297 1.672 2.094 1.156 1.031 2.125 1.359 2.438 1.516.313.156.484.125.672-.078.188-.203.781-.906.984-1.219.203-.313.422-.266.703-.156.281.109 1.813.859 2.125 1.016.313.156.516.234.594.359.078.125.078.734-.172 1.438z"/>
            </svg>
            <span>+91 98096 65188</span>
          </a>
          <a href="/contact/" class="btn-primary w-full text-sm text-center">Contact us</a>
        </li>
      </ul>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(isOpen));
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });

  // Close menu on resize to desktop
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768) {
      menu?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    }
  });
</script>

