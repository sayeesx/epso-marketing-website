---
interface Props {
  heading?: string;
  subheading?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  imageSrc?: string;
  imageAlt?: string;
}

const {
  heading = 'From Our Products to Your Everyday Moments.',
  primaryCta = { label: 'Explore products', href: '/products/' },
  secondaryCta = { label: 'About Epso', href: '/about/' },
  imageSrc = '/assets/banners/EPSO-Marketing-Truck-on-Globe.webp',
  imageAlt = 'Epso marketing truck delivering everyday food and home care products on the globe',
} = Astro.props;
---
<section
  id="hero-section"
  class="relative overflow-hidden w-full pt-4 sm:pt-6 md:pt-8 pb-0 flex flex-col items-center justify-between"
  style="background: radial-gradient(circle at 50% 30%, rgba(255, 255, 255, 0.95) 0%, rgba(254, 235, 211, 0.6) 42%, rgba(246, 184, 116, 0.45) 72%, transparent 100%), linear-gradient(180deg, #FFFFFF 0%, #FFF9F3 18%, #FDEBD3 40%, #F6B874 68%, #EB8D35 100%);"
>
  <!-- Atmospheric golden ambient glow behind the title -->
  <div
    class="pointer-events-none absolute top-2 sm:top-4 left-1/2 -translate-x-1/2 -z-10 h-[380px] w-full max-w-6xl rounded-full bg-gradient-to-b from-amber-200/35 via-orange-300/20 to-transparent blur-3xl"
    aria-hidden="true"
  ></div>

  <!-- TITLE BEHIND THE IMAGE (Rendered in Insanibc font with balanced, refined scale) -->
  <div class="relative z-0 w-full max-w-5xl px-4 sm:px-6 lg:px-8 text-center select-none -mt-2 sm:-mt-3">
    <h1
      class="font-insanibc uppercase tracking-wide text-brand-950 text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl leading-[1.05] drop-shadow-xs"
      style="font-family: 'Insanibc', 'Insaniburger with Cheese', sans-serif !important; font-weight: normal; font-style: normal;"
    >
      {heading}
    </h1>
  </div>

  <!-- 3D TRUCK ON GLOBE: FULL WIDTH OF SCREEN ACROSS PORTRAIT & LANDSCAPE (shifted slightly down) -->
  <div class="relative z-10 w-full px-0 mt-2 sm:mt-1 md:-mt-2 lg:-mt-4 flex flex-col items-center overflow-hidden">
    <div class="w-full flex justify-center animate-float">
      <img
        src={imageSrc}
        alt={imageAlt}
        width="1661"
        height="947"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
        class="w-full min-w-full max-w-none h-auto object-cover sm:object-contain object-bottom filter drop-shadow-[0_25px_45px_rgba(235,141,53,0.38)] transition-transform duration-700"
      />
    </div>

    <!-- Marketplace availability badge & quick action buttons shifted higher onto the hero globe -->
    <div class="relative z-30 -mt-24 sm:-mt-40 md:-mt-56 lg:-mt-72 pb-12 sm:pb-24 md:pb-32 lg:pb-40 flex flex-col items-center gap-3 px-4">
      <div class="inline-flex flex-col sm:flex-row items-center gap-2 sm:gap-3 rounded-2xl sm:rounded-full border border-white/80 bg-white/85 px-4 sm:px-5 py-1.5 sm:py-2 backdrop-blur-md transition-colors duration-300 hover:bg-white">
        <span class="text-xs font-semibold tracking-wide text-brand-900/90 whitespace-nowrap">
          Available now on
        </span>
        <div class="flex items-center gap-3 sm:gap-4">
          <div class="transition-transform hover:scale-105 flex items-center" title="Amazon">
            <img
              src="/assets/marketplaces/amazon.svg"
              alt="Amazon"
              width="72"
              height="22"
              class="h-3.5 sm:h-4 w-auto object-contain translate-y-0.5"
            />
          </div>
          <span class="h-3 w-px bg-brand-300/70 hidden sm:block" aria-hidden="true"></span>
          <div class="transition-transform hover:scale-105 flex items-center" title="Flipkart">
            <img
              src="/assets/marketplaces/flipkart.svg"
              alt="Flipkart"
              width="76"
              height="23"
              class="h-4 sm:h-4.5 w-auto object-contain"
            />
          </div>
          <span class="h-3 w-px bg-brand-300/70 hidden sm:block" aria-hidden="true"></span>
          <div class="transition-transform hover:scale-105 flex items-center gap-1" title="JioMart">
            <img
              src="/assets/marketplaces/jiomart.svg"
              alt="JioMart"
              width="18"
              height="18"
              class="h-4 w-4 object-contain rounded-full"
            />
            <span class="text-xs sm:text-[13px] font-extrabold tracking-tight text-[#1a1a1a]">JioMart</span>
          </div>
        </div>
      </div>

      <!-- Quick action buttons (shadow-free) -->
      <div class="flex flex-col sm:flex-row items-center gap-3.5">
        <a href={primaryCta.href} class="btn-primary text-base px-8 py-3 transition-transform hover:-translate-y-0.5">
          {primaryCta.label}
        </a>
        <a href={secondaryCta.href} class="btn-secondary text-base px-8 py-3 bg-white/90 backdrop-blur-md transition-transform hover:-translate-y-0.5">
          {secondaryCta.label}
        </a>
      </div>
    </div>
  </div>

  <!-- Clean soft bottom-edge fade into white page when hero is at rest -->
  <div
    class="pointer-events-none absolute bottom-0 inset-x-0 z-20 h-14 sm:h-20 bg-gradient-to-t from-white via-white/80 to-transparent"
    aria-hidden="true"
  ></div>
</section>

<!-- SCROLL-ONLY THREE.JS VOLUMETRIC SMOKE EFFECT (Animates smoothly only while scrolling) -->
<div
  id="hero-smoke-container"
  class="pointer-events-none fixed inset-0 z-[45] w-full h-full overflow-hidden opacity-0 invisible"
  aria-hidden="true"
></div>

<!-- Three.js WebGL FBM Volumetric Smoke Shader (MIT open-source library, renders only during scroll) -->
<script>
  import * as THREE from 'three';

  function initRealisticSmokeClouds() {
    const container = document.getElementById('hero-smoke-container');
    const hero = document.getElementById('hero-section');
    if (!container || !hero) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({
        alpha: true,
        antialias: true,
        powerPreference: 'high-performance',
      });
    } catch {
      return;
    }

    const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
    renderer.setPixelRatio(dpr);
    renderer.setClearColor(0x000000, 0);
    renderer.domElement.style.width = '100%';
    renderer.domElement.style.height = '100%';
    renderer.domElement.style.display = 'block';
    container.appendChild(renderer.domElement);

    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

    const drawingSize = new THREE.Vector2();
    const uniforms = {
      uResolution: { value: new THREE.Vector2(1, 1) },
      uTime: { value: 0 },
      uScroll: { value: 0 },
      uActivity: { value: 0 },
    };

    const vertexShader = `
      void main() {
        gl_Position = vec4(position, 1.0);
      }
    `;

    // 6-octave FBM with domain warping & atmospheric smoke contrast (active only on scroll)
    const fragmentShader = `
      precision highp float;
      uniform vec2 uResolution;
      uniform float uTime;
      uniform float uScroll;
      uniform float uActivity;

      float hash(vec2 p) {
        p = fract(p * vec2(123.34, 456.21));
        p += dot(p, p + 45.32);
        return fract(p.x * p.y);
      }

      float noise(vec2 p) {
        vec2 i = floor(p);
        vec2 f = fract(p);
        vec2 u = f * f * (3.0 - 2.0 * f);
        float a = hash(i);
        float b = hash(i + vec2(1.0, 0.0));
        float c = hash(i + vec2(0.0, 1.0));
        float d = hash(i + vec2(1.0, 1.0));
        return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
      }

      const mat2 rot = mat2(0.80, 0.60, -0.60, 0.80);

      float fbm(vec2 p) {
        float v = 0.0;
        float a = 0.5;
        for (int i = 0; i < 6; i++) {
          v += a * noise(p);
          p = rot * p * 2.03 + vec2(17.1, 31.7);
          a *= 0.5;
        }
        return v;
      }

      float smokeDensity(vec2 uv, float t, float s) {
        float aspect = uResolution.x / max(uResolution.y, 1.0);
        vec2 p = vec2(uv.x * aspect, uv.y) * 2.35;

        // Swirl driven directly by scroll displacement + gentle upward smoke flow
        vec2 drift = vec2(t * 0.06 + s * 0.45, -t * 0.08 - s * 1.15);

        vec2 q = vec2(
          fbm(p + drift * 0.7),
          fbm(p + vec2(5.2, 1.3) + drift * 0.5)
        );
        vec2 r = vec2(
          fbm(p + 2.1 * q + vec2(1.7, 9.2) + drift * 1.1),
          fbm(p + 2.1 * q + vec2(8.3, 2.8) + drift * 0.9)
        );
        return fbm(p + 1.85 * r + drift * 0.4);
      }

      void main() {
        vec2 uv = gl_FragCoord.xy / max(uResolution.xy, vec2(1.0));
        float y = uv.y;

        float n = smokeDensity(uv, uTime, uScroll);
        float nLight = smokeDensity(uv + vec2(0.0, 0.025), uTime, uScroll);
        float scatter = clamp((n - nLight) * 4.2, -0.35, 0.75);

        // Smoke surges upward with scroll then opens outward from center like a parting curtain
        float expand = smoothstep(0.0, 0.35, uScroll);
        float part   = smoothstep(0.50, 1.0, uScroll);

        // Airy smoke wisps (not an opaque white wall) with soft screen-edge fade
        float edgeFade = smoothstep(0.0, 0.14, y) * smoothstep(1.0, 0.78, y);
        float centerDist = abs(uv.x - 0.5) * 2.0;
        float partMask = mix(1.0, smoothstep(0.0, 0.95, centerDist + (1.0 - part) * 0.55 - 0.30), part);

        float smokeWisp = smoothstep(0.36, 0.80, n + expand * 0.14);
        float alpha = clamp(smokeWisp * edgeFade * partMask * uActivity * 0.72, 0.0, 0.72);

        // Visible volumetric contrast: warm ivory highlights + soft mist gray-taupe shadows
        vec3 sunCrest    = vec3(1.000, 0.992, 0.975);
        vec3 smokeMid    = vec3(0.940, 0.905, 0.865);
        vec3 smokeShadow = vec3(0.820, 0.745, 0.675);

        vec3 col = mix(sunCrest, smokeMid, smoothstep(0.30, 0.75, n));
        col = mix(col, smokeShadow, clamp(scatter, 0.0, 0.55));

        gl_FragColor = vec4(col, alpha);
      }
    `;

    const geometry = new THREE.PlaneGeometry(2, 2);
    const material = new THREE.ShaderMaterial({
      uniforms,
      vertexShader,
      fragmentShader,
      transparent: true,
      depthWrite: false,
      depthTest: false,
    });
    const quad = new THREE.Mesh(geometry, material);
    scene.add(quad);

    function resize() {
      if (!container) return;
      const w = container.clientWidth;
      const h = container.clientHeight;
      if (w === 0 || h === 0) return;
      renderer.setSize(w, h, false);
      renderer.getDrawingBufferSize(drawingSize);
      uniforms.uResolution.value.copy(drawingSize);
    }

    resize();
    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(container);

    let lastScrollY = window.scrollY;
    let targetActivity = 0;
    let currentActivity = 0;
    let smokeTime = 0;
    let scrollIdleTimer: number | undefined;
    let rafId = 0;
    let lastFrameTime = performance.now();

    function onScroll() {
      const y = window.scrollY;
      const delta = Math.abs(y - lastScrollY);
      lastScrollY = y;

      const heroH = hero?.offsetHeight || 750;
      const progress = Math.min(Math.max(y / heroH, 0), 1);
      uniforms.uScroll.value = progress;

      // Only activate smoke while actively scrolling inside/past the hero zone (not at rest at top)
      if (y > 4 && progress < 0.98 && delta > 0) {
        targetActivity = Math.min(1, 0.55 + Math.min(delta / 40, 0.45));
        smokeTime += delta * 0.008;
        if (scrollIdleTimer) window.clearTimeout(scrollIdleTimer);
        scrollIdleTimer = window.setTimeout(() => {
          targetActivity = 0;
        }, 450);
      } else if (y <= 4 || progress >= 0.98) {
        targetActivity = 0;
      }

      if ((targetActivity > 0 || currentActivity > 0.01) && !rafId) {
        lastFrameTime = performance.now();
        rafId = requestAnimationFrame(animate);
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });

    function animate(now: number) {
      const dt = Math.min((now - lastFrameTime) * 0.001, 0.05);
      lastFrameTime = now;

      // Smoothly ramp activity in when scrolling, and gently dissipate when stopped
      const lerpRate = targetActivity > currentActivity ? 8.0 : 2.6;
      currentActivity += (targetActivity - currentActivity) * Math.min(1, dt * lerpRate);

      if (currentActivity <= 0.005 && targetActivity === 0) {
        currentActivity = 0;
        uniforms.uActivity.value = 0;
        container!.style.opacity = '0';
        container!.style.visibility = 'hidden';
        rafId = 0;
        return;
      }

      container!.style.visibility = 'visible';
      container!.style.opacity = '1';
      smokeTime += dt * (0.65 + currentActivity * 0.85);
      uniforms.uTime.value = smokeTime;
      uniforms.uActivity.value = currentActivity;

      renderer.render(scene, camera);
      rafId = requestAnimationFrame(animate);
    }

    window.addEventListener(
      'pagehide',
      () => {
        if (rafId) cancelAnimationFrame(rafId);
        if (scrollIdleTimer) window.clearTimeout(scrollIdleTimer);
        resizeObserver.disconnect();
        window.removeEventListener('scroll', onScroll);
        geometry.dispose();
        material.dispose();
        renderer.dispose();
      },
      { once: true }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRealisticSmokeClouds);
  } else {
    initRealisticSmokeClouds();
  }
</script>

