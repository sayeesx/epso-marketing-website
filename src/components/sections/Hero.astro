---
interface Props {
  heading?: string;
  subheading?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  imageSrc?: string;
  imageAlt?: string;
}

const {
  heading = 'From Our Products to Your Everyday Moments.',
  primaryCta = { label: 'Explore products', href: '/products/' },
  secondaryCta = { label: 'About Epso', href: '/about/' },
  imageSrc = '/assets/banners/EPSO-Marketing-Truck-on-Globe.webp',
  imageAlt = 'Epso marketing truck delivering everyday food and home care products on the globe',
} = Astro.props;
---
<section
  id="hero-section"
  class="relative overflow-hidden w-full pt-8 sm:pt-6 md:pt-6 pb-0 flex flex-col items-center"
  style="background: radial-gradient(circle at 50% 28%, rgba(255, 255, 255, 0.98) 0%, rgba(255, 245, 232, 0.7) 45%, rgba(253, 224, 190, 0.35) 72%, rgba(255, 255, 255, 0) 100%), linear-gradient(180deg, #FFFFFF 0%, #FFFCF8 20%, #FFF1DF 45%, #FDE2C0 68%, #FFF7ED 86%, #FFFFFF 100%);"
>
  <!-- Soft ambient glow behind the title -->
  <div
    class="pointer-events-none absolute top-2 sm:top-4 left-1/2 -translate-x-1/2 -z-10 h-[360px] w-full max-w-6xl rounded-full bg-gradient-to-b from-amber-100/35 via-orange-100/20 to-transparent blur-3xl"
    aria-hidden="true"
  ></div>

  <!-- TITLE BEHIND THE IMAGE (Rendered in Insanibc font with balanced, refined scale) -->
  <div class="relative z-0 w-full max-w-5xl px-4 sm:px-6 lg:px-8 text-center select-none mt-0 sm:-mt-2">
    <h1
      class="font-insanibc uppercase tracking-wide text-brand-950 text-[26px] sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl leading-[1.05] drop-shadow-xs"
      style="font-family: 'Insanibc', 'Insaniburger with Cheese', sans-serif !important; font-weight: normal; font-style: normal;"
    >
      {heading}
    </h1>
  </div>

  <!-- 3D TRUCK ON GLOBE: FULL WIDTH OF SCREEN, STATIC (NO FLOAT), LIGHT & SEAMLESS ALPHA DISSOLVE -->
  <div class="relative z-10 w-full px-0 mt-1 sm:mt-0 md:-mt-2 lg:-mt-4 overflow-hidden">
    <img
      src={imageSrc}
      alt={imageAlt}
      title="Epso Marketing delivery truck delivering everyday food and home care products across Kerala and India"
      width="1661"
      height="947"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
      class="block w-full h-auto object-cover object-top -mb-[7%]"
      style="-webkit-mask-image: linear-gradient(to bottom, #000000 0%, #000000 60%, rgba(0,0,0,0.86) 72%, rgba(0,0,0,0.52) 84%, rgba(0,0,0,0.16) 94%, transparent 100%); mask-image: linear-gradient(to bottom, #000000 0%, #000000 60%, rgba(0,0,0,0.86) 72%, rgba(0,0,0,0.52) 84%, rgba(0,0,0,0.16) 94%, transparent 100%);"
    />

    <!-- Light, subtle pure-white bottom feather to ensure zero hard seam against the page background -->
    <div
      class="pointer-events-none absolute bottom-0 inset-x-0 z-20 h-[24%] sm:h-[22%] md:h-[20%]"
      style="background: linear-gradient(to top, #ffffff 0%, rgba(255,255,255,0.88) 28%, rgba(255,255,255,0.45) 62%, rgba(255,255,255,0) 100%);"
      aria-hidden="true"
    ></div>

    <!-- Marketplace availability badge & desktop-only action buttons shifted higher onto the hero globe -->
    <div class="absolute inset-x-0 bottom-[22%] sm:bottom-[23%] md:bottom-[26%] lg:bottom-[29%] z-30 flex flex-col items-center gap-2.5 px-3 sm:px-4">
      <div class="inline-flex flex-row items-center gap-2 sm:gap-3 rounded-full border border-white/80 bg-white/85 px-2.5 sm:px-5 py-1 sm:py-2 backdrop-blur-md transition-colors duration-300 hover:bg-white">
        <span class="text-[9.5px] sm:text-xs font-semibold tracking-wide text-brand-900/90 whitespace-nowrap">
          Available now on
        </span>
        <div class="flex items-center gap-2 sm:gap-4">
          <div class="transition-transform hover:scale-105 flex items-center" title="Amazon">
            <img
              src="/assets/marketplaces/amazon.svg"
              alt="Amazon"
              width="72"
              height="22"
              class="h-2.5 sm:h-4 w-auto object-contain translate-y-[1px] sm:translate-y-0.5"
            />
          </div>
          <span class="h-2.5 sm:h-3 w-px bg-brand-300/70" aria-hidden="true"></span>
          <div class="transition-transform hover:scale-105 flex items-center" title="Flipkart">
            <img
              src="/assets/marketplaces/flipkart.svg"
              alt="Flipkart"
              width="86"
              height="26"
              class="h-[13px] sm:h-[22px] w-auto object-contain"
            />
          </div>
          <span class="h-2.5 sm:h-3 w-px bg-brand-300/70" aria-hidden="true"></span>
          <div class="transition-transform hover:scale-105 flex items-center gap-0.5 sm:gap-1" title="JioMart">
            <img
              src="/assets/marketplaces/jiomart.svg"
              alt="JioMart"
              width="18"
              height="18"
              class="h-2.5 sm:h-4 w-2.5 sm:w-4 object-contain rounded-full"
            />
            <span class="text-[9.5px] sm:text-[13px] font-extrabold tracking-tight text-[#1a1a1a]">JioMart</span>
          </div>
        </div>
      </div>

      <!-- Quick action buttons (desktop/tablet only, hidden on mobile browsers) -->
      <div class="hidden md:flex items-center gap-3">
        <a href={primaryCta.href} class="btn-primary min-w-[210px] px-10 py-2 text-sm transition-transform hover:-translate-y-0.5">
          {primaryCta.label}
        </a>
        <a href={secondaryCta.href} class="btn-secondary min-w-[210px] px-10 py-2 text-sm bg-white/90 backdrop-blur-md transition-transform hover:-translate-y-0.5">
          {secondaryCta.label}
        </a>
      </div>
    </div>
  </div>
</section>

<!-- SCROLL-ONLY THREE.JS VOLUMETRIC SMOKE EFFECT (Animates smoothly only while scrolling) -->
<div
  id="hero-smoke-container"
  class="pointer-events-none fixed inset-0 z-[45] w-full h-full overflow-hidden"
  style="opacity: 0; visibility: hidden;"
  aria-hidden="true"
></div>

<!-- Three.js WebGL FBM Volumetric Smoke Shader (MIT open-source library, renders during hero scroll) -->
<script>
  import * as THREE from 'three';

  function initRealisticSmokeClouds() {
    const container = document.getElementById('hero-smoke-container');
    const hero = document.getElementById('hero-section');
    const whatWeMake = document.getElementById('what-we-make');
    if (!container || !hero) return;

    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({
        alpha: true,
        antialias: false,
        powerPreference: 'high-performance',
      });
    } catch {
      return;
    }

    // Render soft cloud canvas at 0.55x on mobile for crisp billows and 0.35x on desktop for 120fps scrolling
    const isMobileViewport = (window.innerWidth || 1280) < 768;
    renderer.setPixelRatio(isMobileViewport ? 0.55 : 0.35);
    renderer.setClearColor(0x000000, 0);
    renderer.domElement.style.width = '100%';
    renderer.domElement.style.height = '100%';
    renderer.domElement.style.display = 'block';
    container.appendChild(renderer.domElement);

    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

    const uniforms = {
      uAspect: { value: (container.clientWidth || window.innerWidth || 1280) / Math.max(container.clientHeight || window.innerHeight || 720, 1) },
      uTime: { value: 0 },
      uScroll: { value: 0 },
      uVisibility: { value: 0 },
      uCutoffUv: { value: 0 },
    };

    const vertexShader = `
      varying vec2 vUv;
      void main() {
        vUv = uv;
        gl_Position = vec4(position, 1.0);
      }
    `;

    // Fast GPU-optimized 4-octave FBM with highp precision & FP16-safe hash for mobile GPUs
    const fragmentShader = `
      #ifdef GL_FRAGMENT_PRECISION_HIGH
      precision highp float;
      #else
      precision mediump float;
      #endif
      varying vec2 vUv;
      uniform float uAspect;
      uniform float uTime;
      uniform float uScroll;
      uniform float uVisibility;
      uniform float uCutoffUv;

      float hash(vec2 p) {
        vec3 p3 = fract(vec3(p.xyx) * 0.1031);
        p3 += dot(p3, p3.yzx + 33.33);
        return fract((p3.x + p3.y) * p3.z);
      }

      float noise(vec2 p) {
        vec2 i = floor(p);
        vec2 f = fract(p);
        vec2 u = f * f * (3.0 - 2.0 * f);
        float a = hash(i);
        float b = hash(i + vec2(1.0, 0.0));
        float c = hash(i + vec2(0.0, 1.0));
        float d = hash(i + vec2(1.0, 1.0));
        return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
      }

      float fbm(vec2 p) {
        float v = 0.0;
        float a = 0.5;
        for (int i = 0; i < 4; i++) {
          v += a * noise(p);
          p = vec2(0.80 * p.x + 0.60 * p.y, -0.60 * p.x + 0.80 * p.y) * 2.04 + vec2(1.71, 3.17);
          a *= 0.5;
        }
        return v;
      }

      void main() {
        vec2 uv = vUv;
        float y = uv.y;

        // Keep cloud billows isotropic and well-proportioned on both portrait mobile and widescreen desktop
        float scaleX = max(uAspect, 1.0);
        float scaleY = max(1.0 / max(uAspect, 0.35), 1.0);
        vec2 p = vec2(uv.x * scaleX, y * scaleY) * 2.05;
        vec2 drift = vec2(uTime * 0.08 + uScroll * 0.70, -uTime * 0.11 - uScroll * 1.45);

        vec2 q = vec2(
          fbm(p + drift * 0.70),
          fbm(p + vec2(5.2, 1.3) + drift * 0.55)
        );
        float n = fbm(p + 1.85 * q + drift * 0.40);
        // Fast directional highlight approximation
        float nLight = noise((p + 1.85 * q + drift * 0.40) + vec2(0.0, 0.15));
        float scatter = clamp((n - nLight) * 2.2, -0.25, 0.70);

        float density = smoothstep(0.24, 0.56, n);
        float expand = smoothstep(0.0, 0.30, uScroll);
        float part   = smoothstep(0.62, 1.0, uScroll);

        // Feather smoothly at the top viewport edge and just above "What we make" (edge0 < edge1 strictly for GLSL ES)
        float topFade = 1.0 - smoothstep(0.93, 1.0, y);
        float bottomFade = smoothstep(uCutoffUv, uCutoffUv + 0.06, y);
        float edgeFade = topFade * bottomFade;

        float centerDist = abs(uv.x - 0.5) * 2.0;
        float partMask = mix(1.0, smoothstep(0.0, 0.90, centerDist + (1.0 - part) * 0.60 - 0.25), part);
        float scrollLighten = 1.0 - smoothstep(0.15, 0.95, uScroll) * 0.65;

        float alpha = clamp(density * (0.72 + expand * 0.18) * edgeFade * partMask * scrollLighten * uVisibility * 0.72, 0.0, 0.72);

        // Light, airy whitish cumulus clouds that thin out gently as the user scrolls
        vec3 sunCrest    = vec3(1.000, 1.000, 1.000);
        vec3 smokeMid    = vec3(0.968, 0.973, 0.982);
        vec3 smokeShadow = vec3(0.875, 0.895, 0.925);

        vec3 col = mix(sunCrest, smokeMid, density);
        col = mix(col, smokeShadow, clamp(scatter * 0.75, 0.0, 0.55));

        gl_FragColor = vec4(col, alpha);
      }
    `;

    const geometry = new THREE.PlaneGeometry(2, 2);
    const material = new THREE.ShaderMaterial({
      uniforms,
      vertexShader,
      fragmentShader,
      transparent: true,
      depthWrite: false,
      depthTest: false,
    });
    const quad = new THREE.Mesh(geometry, material);
    scene.add(quad);

    function resize() {
      const w = container!.clientWidth || window.innerWidth || document.documentElement.clientWidth || 1280;
      const h = container!.clientHeight || window.innerHeight || document.documentElement.clientHeight || 720;
      if (w === 0 || h === 0) return;
      renderer.setPixelRatio(w < 768 ? 0.55 : 0.35);
      renderer.setSize(w, h, false);
      uniforms.uAspect.value = w / Math.max(h, 1);
    }

    resize();
    window.addEventListener('resize', resize, { passive: true });
    window.visualViewport?.addEventListener('resize', resize, { passive: true });

    let targetScrollY = window.scrollY || document.documentElement.scrollTop || 0;
    let smoothScrollY = targetScrollY;
    let smokeTime = 0;
    let rafId = 0;
    let lastFrameTime = performance.now();

    function smoothstep(edge0: number, edge1: number, x: number) {
      const t = Math.min(Math.max((x - edge0) / (edge1 - edge0), 0), 1);
      return t * t * (3 - 2 * t);
    }

    function onScroll() {
      targetScrollY = window.scrollY || document.documentElement.scrollTop || document.body.scrollTop || 0;
      if (targetScrollY > 2 && !rafId) {
        lastFrameTime = performance.now();
        rafId = requestAnimationFrame(animate);
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('touchmove', onScroll, { passive: true });

    function animate(now: number) {
      const dt = Math.min((now - lastFrameTime) * 0.001, 0.05);
      lastFrameTime = now;

      const viewH = container!.clientHeight || window.innerHeight || 720;
      const heroRect = hero!.getBoundingClientRect();
      const heroH = heroRect.height || 750;
      const cutoffY = whatWeMake ? whatWeMake.getBoundingClientRect().top : heroRect.bottom;
      const clampedCutoff = Math.max(0, Math.min(viewH, cutoffY));

      smoothScrollY += (targetScrollY - smoothScrollY) * Math.min(1, dt * 14);
      const scrollSpan = Math.max(heroH * 1.05, 220);
      const progress = Math.min(Math.max(smoothScrollY / scrollSpan, 0), 1);

      const fadeIn = smoothstep(0.0, 0.03, progress);
      const fadeOut = 1 - smoothstep(0.45, 1.0, progress);
      const vis = (smoothScrollY <= 2 && targetScrollY <= 2) || clampedCutoff <= 1 ? 0 : fadeIn * fadeOut;

      if (vis <= 0.005 && (targetScrollY <= 2 || clampedCutoff <= 1 || progress >= 0.995)) {
        uniforms.uVisibility.value = 0;
        container!.style.opacity = '0';
        container!.style.visibility = 'hidden';
        container!.style.clipPath = 'inset(0px 0px 100% 0px)';
        rafId = 0;
        return;
      }

      // Strictly clip smoke to end at the top edge of "What we make"
      const clipBottom = Math.max(0, viewH - clampedCutoff);
      container!.style.clipPath = `inset(0px 0px ${clipBottom}px 0px)`;
      container!.style.visibility = 'visible';
      container!.style.opacity = '1';

      const scrollSpeed = Math.abs(targetScrollY - smoothScrollY);
      smokeTime += dt * (0.35 + Math.min(scrollSpeed * 0.025, 2.5));

      uniforms.uScroll.value = progress;
      uniforms.uTime.value = smokeTime;
      uniforms.uVisibility.value = vis;
      uniforms.uCutoffUv.value = Math.max(0, Math.min(1, 1 - clampedCutoff / Math.max(viewH, 1)));

      renderer.render(scene, camera);
      rafId = requestAnimationFrame(animate);
    }

    if (targetScrollY > 2) {
      onScroll();
    }

    window.addEventListener(
      'pagehide',
      () => {
        if (rafId) cancelAnimationFrame(rafId);
        window.removeEventListener('resize', resize);
        window.visualViewport?.removeEventListener('resize', resize);
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('touchmove', onScroll);
        geometry.dispose();
        material.dispose();
        renderer.dispose();
      },
      { once: true }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRealisticSmokeClouds);
  } else {
    initRealisticSmokeClouds();
  }
</script>

