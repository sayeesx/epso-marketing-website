---
interface Props {
  heading?: string;
  subheading?: string;
  productName?: string;
}
const {
  heading = 'Have a question?',
  subheading = 'We are happy to help. Send us a message and we will get back to you.',
  productName,
} = Astro.props;
---
<section class="section-pad bg-brand-800 text-white">
  <div class="container-site text-center">
    <h2 class="mb-3 text-white">{heading}</h2>
    <p class="mb-6 text-brand-300 max-w-xl mx-auto">
      {productName ? `Interested in ${productName}? ${subheading}` : subheading}
    </p>
    <div class="flex flex-col gap-3 sm:flex-row justify-center">
      <a href="/contact/" class="btn-accent">Contact us</a>
      <a href="/products/" class="btn-secondary">Browse products</a>
    </div>
  </div>
</section>

