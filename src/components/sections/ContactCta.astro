---
interface Props {
  heading?: string;
  subheading?: string;
  productName?: string;
}
const {
  heading = 'Have a question?',
  subheading = 'We are happy to help. Send us a message and we will get back to you.',
  productName,
} = Astro.props;
---
<section class="section-pad bg-transparent">
  <div class="container-site">
    <div class="relative overflow-hidden rounded-3xl bg-black px-6 py-12 text-center text-white border border-neutral-800 shadow-2xl sm:px-12 sm:py-16 md:px-16">
      <div class="relative z-10 max-w-2xl mx-auto">
        <h2 class="mb-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">{heading}</h2>
        <p class="mb-8 text-base text-neutral-300 sm:text-lg leading-relaxed">
          {productName ? `Interested in ${productName}? ${subheading}` : subheading}
        </p>
        <div class="flex flex-col gap-3.5 sm:flex-row justify-center items-center">
          <a href="/contact/" class="btn-accent text-base px-8 py-3">Contact us</a>
          <a href="/products/" class="btn border border-white/25 bg-white/10 text-white hover:bg-white/20 text-base px-8 py-3 rounded-full transition-all">
            Browse products
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

