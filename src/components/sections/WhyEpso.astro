---
import PlaceholderImage from '@components/ui/PlaceholderImage.astro';

const mobileReasons = [
  {
    label: 'Food & snacks photo [To be updated]',
    title: 'Made for Indian homes',
    description: 'Products designed for everyday needs in Indian households.',
  },
  {
    label: 'Quality check photo [To be updated]',
    title: 'Trusted quality',
    description: 'Every product goes through quality checks before reaching you.',
  },
  {
    label: 'Packaging photo [To be updated]',
    title: 'Convenient packaging',
    description: 'Available in sizes that work for your family and your budget.',
  },
  {
    label: 'Ingredients photo [To be updated]',
    title: 'Simple ingredients',
    description: 'We keep things straightforward — good products at fair prices.',
  },
];

const rangePreviewItems = [
  {
    name: 'Kerala Mixtures',
    note: 'Crisp everyday tea-time snacks.',
    label: 'Snacks photo [To be updated]',
  },
  {
    name: 'Dishwash Liquids',
    note: 'Effective kitchen grease cleaning.',
    label: 'Dishwash photo [To be updated]',
  },
  {
    name: 'Floor Cleaners',
    note: 'Fresh everyday household care.',
    label: 'Cleaner photo [To be updated]',
  },
];

const bentoBars = [
  { label: 'Food', height: 'h-16', blue: false },
  { label: 'Care', height: 'h-20', blue: false },
  { label: 'Clean', height: 'h-24', blue: true },
  { label: 'Pack', height: 'h-16', blue: false },
  { label: 'Value', height: 'h-28', blue: true },
  { label: 'Homes', height: 'h-20', blue: false },
  { label: 'Daily', height: 'h-24', blue: false },
];
---
<section class="section-pad bg-white">
  <div class="container-site">
    <div class="mb-10 text-center">
      <h2 class="section-title">Why choose Epso?</h2>
      <p class="section-subtitle mx-auto max-w-xl mt-2">
        Thoughtfully made everyday essentials you can rely on.
      </p>
    </div>

    <!-- Mobile layout: Clean single-column cards (no bento grid on mobile) -->
    <div class="grid grid-cols-1 gap-4 md:hidden">
      {mobileReasons.map((reason) => (
        <article class="rounded-2xl border border-brand-200/80 bg-white p-4 flex items-center gap-4">
          <div class="w-20 shrink-0 overflow-hidden rounded-xl">
            <PlaceholderImage
              width={160}
              height={160}
              label={reason.label}
              aspectRatio="1/1"
              class="rounded-xl text-[10px]"
            />
          </div>
          <div class="min-w-0">
            <h3 class="text-base font-semibold text-brand-950">{reason.title}</h3>
            <p class="mt-1 text-sm text-brand-600 leading-relaxed">{reason.description}</p>
          </div>
        </article>
      ))}
    </div>

    <!-- Desktop layout: Bento grid showcase matching reference palette -->
    <div class="hidden md:grid md:grid-cols-12 md:auto-rows-[76px] lg:auto-rows-[88px] gap-4 rounded-[28px] bg-[#0B0D12] p-4">
      <!-- 1. Top-Left (col 1..3, row 1..4): Orange Product Feature -->
      <div class="col-span-3 row-span-4 rounded-2xl bg-[#F07D32] p-4 flex flex-col justify-between overflow-hidden">
        <div class="flex-1 min-h-0 flex items-center justify-center overflow-hidden rounded-xl bg-white/15">
          <PlaceholderImage
            width={400}
            height={360}
            label="Food product [To be updated]"
            aspectRatio="1/1"
            class="h-full w-full bg-transparent text-white/90"
          />
        </div>
        <div class="pt-3 text-white">
          <h3 class="text-lg font-bold text-white leading-tight">Food Essentials</h3>
          <p class="mt-0.5 text-sm font-medium text-white/85">Everyday Kerala snacks</p>
        </div>
      </div>

      <!-- 2. Center-Top-Left (col 4..6, row 1..2): Soft Blue Pack Preview -->
      <div class="col-span-3 row-span-2 rounded-2xl bg-[#B4CCFA] px-4 pt-3 pb-0 flex items-end justify-center overflow-hidden">
        <div class="w-[78%] h-[88%] rounded-t-2xl border-4 border-b-0 border-brand-950 bg-white p-2 overflow-hidden flex flex-col gap-1.5">
          <div class="flex items-center justify-between text-[10px] font-semibold text-brand-700 px-1">
            <span>Epso Range</span>
            <span class="rounded-full bg-[#F07D32]/15 px-1.5 py-0.5 text-[#c95b14]">Daily</span>
          </div>
          <div class="flex-1 min-h-0 overflow-hidden rounded-lg">
            <PlaceholderImage
              width={240}
              height={150}
              label="Pack preview [To be updated]"
              aspectRatio="16/10"
              class="h-full w-full rounded-lg"
            />
          </div>
        </div>
      </div>

      <!-- 3. Center-Top-Right (col 7..9, row 1..2): Soft Blue Quality Highlights + Image -->
      <div class="col-span-3 row-span-2 rounded-2xl bg-[#B4CCFA] p-3 flex flex-col justify-between overflow-hidden">
        <div class="space-y-1.5">
          <div class="flex items-center gap-2 rounded-xl bg-brand-900/75 px-2.5 py-1.5 text-white backdrop-blur-sm">
            <span class="h-2.5 w-2.5 rounded-full bg-[#F07D32] shrink-0" aria-hidden="true"></span>
            <span class="text-[11px] font-medium truncate">Checked before packing</span>
          </div>
          <div class="flex items-center gap-2 rounded-xl bg-brand-900/75 px-2.5 py-1.5 text-white backdrop-blur-sm">
            <span class="h-2.5 w-2.5 rounded-full bg-[#F07D32] shrink-0" aria-hidden="true"></span>
            <span class="text-[11px] font-medium truncate">Convenient family pack sizes</span>
          </div>
        </div>
        <div class="mt-2 h-14 overflow-hidden rounded-xl">
          <PlaceholderImage
            width={320}
            height={120}
            label="Home care [To be updated]"
            aspectRatio="8/3"
            class="h-full w-full rounded-xl bg-white/70 text-brand-600"
          />
        </div>
      </div>

      <!-- 4. Top-Right (col 10..12, row 1..4): Orange Product Range List -->
      <div class="col-span-3 row-span-4 rounded-2xl bg-[#F07D32] p-4 flex flex-col overflow-hidden">
        <h3 class="text-lg font-bold text-white leading-tight mb-3">Product Range</h3>
        <div class="flex-1 flex flex-col justify-between gap-2.5">
          {rangePreviewItems.map((item) => (
            <div class="rounded-xl bg-white p-2.5 flex items-center justify-between gap-2.5 flex-1">
              <div class="min-w-0">
                <p class="text-xs font-bold text-brand-950 truncate">{item.name}</p>
                <p class="mt-0.5 text-[11px] text-brand-600 leading-snug line-clamp-2">{item.note}</p>
              </div>
              <div class="w-12 h-12 shrink-0 overflow-hidden rounded-lg">
                <PlaceholderImage
                  width={96}
                  height={96}
                  label={item.label}
                  aspectRatio="1/1"
                  class="h-full w-full rounded-lg text-[9px]"
                />
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- 5. Center-Middle (col 4..9, row 3..6): Main Orange Pillar Visual -->
      <div class="relative col-span-6 row-span-4 rounded-2xl bg-[#F07D32] p-6 flex flex-col justify-between overflow-hidden">
        <span
          class="pointer-events-none absolute -top-2 right-4 text-6xl lg:text-7xl font-black tracking-tight text-white/15 select-none"
          aria-hidden="true"
        >
          EPSO
        </span>
        <div class="relative z-10 text-white">
          <p class="text-xs font-semibold uppercase tracking-wider text-white/85">Everyday Essentials</p>
          <h3 class="mt-1 text-2xl lg:text-3xl font-extrabold text-white leading-tight">
            Built for Indian Homes
          </h3>
          <p class="mt-1 text-sm text-white/85">Simple products, reliable packs, fair prices</p>
        </div>

        <!-- Bar visual matching the reference centrepiece -->
        <div class="relative z-10 mt-auto flex items-end justify-between gap-3 pt-4">
          {bentoBars.map((bar) => (
            <div class="flex-1 flex flex-col items-center gap-1.5">
              <div
                class={`w-full rounded-t-xl transition-transform duration-300 hover:-translate-y-1 ${bar.height} ${
                  bar.blue ? 'bg-[#B4CCFA]' : 'bg-white'
                }`}
              />
              <span class="text-[11px] font-medium text-white/90">{bar.label}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- 6. Mid-Right (col 10..12, row 5..6): Soft Blue Floating Benefit Chips -->
      <div class="relative col-span-3 row-span-2 rounded-2xl bg-[#B4CCFA] p-3.5 flex flex-col justify-center gap-2 overflow-hidden">
        <div class="self-start rounded-full bg-white px-3 py-1 text-[11px] font-semibold text-brand-900 flex items-center gap-1.5">
          <span>Food &amp; Snacks</span>
          <span class="h-2 w-2 rounded-full bg-[#F07D32]" aria-hidden="true"></span>
        </div>
        <div class="self-end rounded-full bg-white px-3 py-1 text-[11px] font-semibold text-brand-900 flex items-center gap-1.5">
          <span>Home Care Range</span>
          <span class="h-2 w-2 rounded-full bg-[#F07D32]" aria-hidden="true"></span>
        </div>
        <div class="flex items-center justify-between pt-0.5">
          <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-emerald-500/25">
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
          </span>
          <div class="rounded-full bg-white px-3 py-1 text-[11px] font-semibold text-brand-900 flex items-center gap-1.5">
            <span>Fair Everyday Value</span>
            <span class="h-2 w-2 rounded-full bg-[#F07D32]" aria-hidden="true"></span>
          </div>
        </div>
      </div>

      <!-- 7. Bottom-Left (col 1..3, row 5..8): Soft Blue Lifestyle + Steps -->
      <div class="relative col-span-3 row-span-4 rounded-2xl bg-[#B4CCFA] p-4 flex flex-col justify-between overflow-hidden">
        <div class="flex-1 min-h-0 overflow-hidden rounded-xl">
          <PlaceholderImage
            width={400}
            height={420}
            label="Household photo [To be updated]"
            aspectRatio="4/5"
            class="h-full w-full rounded-xl bg-white/55 text-brand-700"
          />
        </div>
        <div class="mt-2.5 flex flex-col gap-1.5">
          <div class="self-start rounded-full bg-white px-3 py-1 text-[11px] font-semibold text-brand-900">
            1. Everyday essentials
          </div>
          <div class="self-end rounded-full bg-white px-3 py-1 text-[11px] font-semibold text-brand-900">
            2. Hygienic packaging
          </div>
          <div class="self-center rounded-full bg-white px-3 py-1 text-[11px] font-semibold text-brand-900">
            3. Ready for every home
          </div>
        </div>
      </div>

      <!-- 8. Bottom-Center (col 4..6, row 7..8): Orange Quality Standard Card -->
      <div class="col-span-3 row-span-2 rounded-2xl bg-[#F07D32] p-3.5 flex flex-col justify-between overflow-hidden">
        <h3 class="text-base font-bold text-white leading-tight">Trusted Quality</h3>
        <div class="rounded-xl bg-white p-2.5 text-brand-900">
          <div class="flex items-center justify-between gap-2">
            <span class="text-xs font-bold text-brand-950">Batch Checked</span>
            <span class="rounded-md bg-emerald-600 px-1.5 py-0.5 text-[10px] font-bold text-white">OK</span>
          </div>
          <p class="mt-1 text-[11px] text-brand-600 leading-snug line-clamp-2">
            Every product goes through quality checks before reaching your home.
          </p>
        </div>
      </div>

      <!-- 9. Bottom-Right (col 7..12, row 7..8): Light Availability Banner -->
      <div class="relative col-span-6 row-span-2 rounded-2xl bg-[#F8FAFC] p-3 overflow-hidden flex items-center justify-center">
        <div class="w-full h-full overflow-hidden rounded-xl">
          <PlaceholderImage
            width={640}
            height={180}
            label="Delivery & availability banner [To be updated]"
            aspectRatio="16/5"
            class="h-full w-full rounded-xl bg-brand-100/80 text-brand-500"
          />
        </div>
        <div class="pointer-events-none absolute bottom-4 left-1/2 -translate-x-1/2 rounded-full bg-brand-950/90 px-4 py-1.5 text-xs font-semibold text-white whitespace-nowrap">
          Available across Amazon, Flipkart &amp; JioMart
        </div>
      </div>
    </div>
  </div>
</section>
