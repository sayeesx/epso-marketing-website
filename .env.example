# ─── Sanity CMS Configuration ────────────────────────────────────────────────
# Get these from https://sanity.io/manage → your project
SANITY_PROJECT_ID=your_project_id_here
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
# SANITY_API_TOKEN is used server-side (Cloudflare Pages Functions / local dev) — never expose in public builds
# SANITY_API_TOKEN=your_editor_token_here

# ─── Site URL ─────────────────────────────────────────────────────────────────
# Used for canonical URLs and sitemap
SITE_URL=https://epso.in

# ─── Contact / Enquiry Settings ───────────────────────────────────────────────
ENQUIRY_WHATSAPP=+919809665188
# ENQUIRY_EMAIL=info@epso.in

